<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MicaAgenda.Desktop.SettingsWindow"
        Title="设置"
        Width="720" Height="600"
        MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#F7F8FA"
        FontSize="13"
        RequestedThemeVariant="Light"
        x:CompileBindings="False">

  <Window.Styles>
    <!-- 卡片标题：左侧一道蓝色竖条（Border.titleBar），替代过去光秃秃的粗体黑字 -->
    <Style Selector="Border.titleBar">
      <Setter Property="Width" Value="3.5" />
      <Setter Property="Height" Value="14" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Margin" Value="0,0,9,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.titleBar.danger">
      <Setter Property="Background" Value="#DC2626" />
    </Style>
    <Style Selector="TextBlock.groupTitle">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#111827" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="DockPanel.cardHead">
      <Setter Property="Margin" Value="0,0,0,11" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="Foreground" Value="#6B7280" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#9CA3AF" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBox.inputBox">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="BorderBrush" Value="#E2E6EB" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector="Button.actionButton">
      <Setter Property="Padding" Value="13,6" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#E2E6EB" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#374151" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.actionButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F3F4F6" />
      <Setter Property="BorderBrush" Value="#9CA3AF" />
    </Style>
    <Style Selector="Button.actionButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E5E7EB" />
    </Style>
    <Style Selector="Button.primaryButton">
      <Setter Property="Padding" Value="16,7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#2563EB" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primaryButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1D4ED8" />
      <Setter Property="BorderBrush" Value="#1D4ED8" />
    </Style>
    <Style Selector="Button.primaryButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1E40AF" />
      <Setter Property="BorderBrush" Value="#1E40AF" />
    </Style>
    <!-- 白色卡片：细边 + 12px 圆角，比旧版大间距硬色块轻 -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#EDF0F3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="15,13" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- ===== 左侧目录按钮 ===== -->
    <Style Selector="Button.navItem">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="#4B5563" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.navItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#4B5563" />
    </Style>
    <Style Selector="Button.navItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F1F3F6" />
    </Style>
    <Style Selector="Button.navItem.active">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.navItem.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#EAF1FE" />
      <Setter Property="Foreground" Value="#1D4ED8" />
    </Style>
    <Style Selector="Button.navItem.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="#B91C1C" />
    </Style>
    <Style Selector="Button.navItem.active.danger /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#FDECEC" />
      <Setter Property="Foreground" Value="#B91C1C" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="150,*">

      <!-- ===== 左侧固定目录：不随右侧内容滚动（粘性），点击即跳转 ===== -->
      <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#EDF0F3" BorderThickness="0,0,1,0">
        <DockPanel Margin="10,12,8,12">
          <StackPanel DockPanel.Dock="Top" Margin="2,0,2,8">
            <TextBlock Text="设置" FontSize="15" FontWeight="Bold" Foreground="#111827" />
            <TextBlock Text="点击目录快速跳转" FontSize="10.5" Foreground="#9CA3AF" Margin="2,3,0,0" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="TocPanel" Spacing="1">
              <Button Classes="navItem" Content="HTTP API" Tag="api" Click="Nav_Click" />
              <Button Classes="navItem" Content="定时提醒" Tag="reminder" Click="Nav_Click" />
              <Button Classes="navItem" Content="定时报告" Tag="report" Click="Nav_Click" />
              <Button Classes="navItem" Content="自动备份" Tag="backup" Click="Nav_Click" />
              <Button Classes="navItem" Content="MCP 接口" Tag="mcp" Click="Nav_Click" />
              <Button Classes="navItem" Content="AI 助手" Tag="ai" Click="Nav_Click" />
              <Button Classes="navItem" Content="桌面行为" Tag="desktop" Click="Nav_Click" />
              <Button Classes="navItem" Content="版本更新" Tag="update" Click="Nav_Click" />
              <Button Classes="navItem" Content="节假日数据" Tag="holiday" Click="Nav_Click" />
              <Button Classes="navItem danger" Content="重置" Tag="reset" Click="Nav_Click" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ===== 右侧：只让这一块滚动，目录与底部按钮始终钉在原位 ===== -->
      <ScrollViewer Grid.Column="1" x:Name="ContentScroll"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    ScrollChanged="ContentScroll_ScrollChanged">
        <StackPanel x:Name="SettingsContent" Margin="14,12,14,4">

        <!-- ===== HTTP API ===== -->
        <Border x:Name="CardApi" Classes="card">
          <StackPanel>
            <DockPanel Classes="cardHead">
              <Border DockPanel.Dock="Left" Classes="titleBar" />
              <TextBlock Text="HTTP API" Classes="groupTitle" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <CheckBox x:Name="ApiEnabledBox" Content="启用 API" VerticalAlignment="Center" Margin="0,0,16,0" />
              <TextBlock Text="端口" Classes="fieldLabel" />
              <TextBox x:Name="ApiPortBox" Width="80" Classes="inputBox" IsReadOnly="True" />
            </StackPanel>
            <TextBlock Text="Token（供其他 Agent 调用时鉴权）" Classes="fieldLabel" Margin="0,0,0,4" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox x:Name="ApiTokenBox" Grid.Column="0" Classes="inputBox" IsReadOnly="True" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Content="复制" Classes="actionButton" Click="CopyToken_Click" />
                <Button Content="重新生成" Classes="actionButton" Margin="8,0,0,0" Click="RegenerateToken_Click" />
              </StackPanel>
            </Grid>
            <TextBlock x:Name="ApiHint" Classes="hint" Margin="0,6,0,0" />
          </StackPanel>
        </Border>

        <!-- ===== 定时提醒 ===== -->
        <Border x:Name="CardReminder" Classes="card">
          <StackPanel>
            <DockPanel Classes="cardHead">
              <Border DockPanel.Dock="Left" Classes="titleBar" />
              <TextBlock Text="定时提醒" Classes="groupTitle" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <CheckBox x:Name="ReminderEnabledBox" Content="启用提醒" VerticalAlignment="Center" Margin="0,0,16,0" />
              <TextBlock Text="提醒时间" Classes="fieldLabel" />
              <TextBox x:Name="ReminderTimeBox" Width="70" Classes="inputBox" />
              <TextBlock Text="（HH:mm）" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
            <TextBlock Text="飞书 webhook 地址" Classes="fieldLabel" Margin="0,0,0,4" />
            <TextBox x:Name="FeishuWebhookBox" Classes="inputBox" Margin="0,0,0,10" />
            <TextBlock Text="企业微信 webhook 地址" Classes="fieldLabel" Margin="0,0,0,4" />
            <TextBox x:Name="WeComWebhookBox" Classes="inputBox" />
            <TextBlock Text="上面两个地址对「定时提醒」和「定时报告」通用。" Classes="hint" Margin="0,6,0,0" />
            <TextBlock Text="「启用提醒」是总开关：除了上面这个点的每日汇总，任务里单独设了具体时间后，也会在这里的地址上收到到点提醒。"
                       Classes="hint" Margin="0,4,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- ===== 定时报告 ===== -->
        <Border x:Name="CardReport" Classes="card">
          <StackPanel>
            <DockPanel Classes="cardHead">
              <Border DockPanel.Dock="Left" Classes="titleBar" />
              <TextBlock Text="定时报告（任务完成情况）" Classes="groupTitle" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <CheckBox x:Name="ReportEnabledBox" Content="启用报告" VerticalAlignment="Center" Margin="0,0,16,0" />
              <TextBlock Text="发送时间" Classes="fieldLabel" />
              <TextBox x:Name="ReportTimeBox" Width="70" Classes="inputBox" />
              <TextBlock Text="（HH:mm）" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <RadioButton x:Name="ReportWeeklyRadio" Content="每周" GroupName="ReportSchedule"
                           VerticalAlignment="Center" Margin="0,0,6,0" IsCheckedChanged="ReportSchedule_Changed" />
              <ComboBox x:Name="ReportDayOfWeekBox" Width="86" Margin="0,0,16,0" VerticalAlignment="Center" />
              <RadioButton x:Name="ReportMonthlyRadio" Content="每月" GroupName="ReportSchedule"
                           VerticalAlignment="Center" Margin="0,0,6,0" IsCheckedChanged="ReportSchedule_Changed" />
              <ComboBox x:Name="ReportDayOfMonthBox" Width="76" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="号（超出当月天数自动取月末）" Foreground="#9CA3AF" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="报告内容：完成率、耗时最长 / 完成最快 / 超时完成 / 至今未完成 / 逾期未完成。"
                       Classes="hint" Margin="0,0,0,10" />
            <TextBlock Text="推送渠道（可多选，勾几个就各发一条）" Classes="fieldLabel" Margin="0,0,0,4" />

            <!-- 每个渠道独立成「勾选 + 输入框」一行：原来两个裸复选框 + 下面一个网址框，
                 会被读成「飞书/企微二选一，再把网址填到下面」，实际是多选且各发一次。
                 现在把网址贴在各自渠道名下，并标明复用提醒的 webhook，语义就没有歧义了。 -->
            <StackPanel Margin="0,0,0,8">
              <CheckBox x:Name="ReportSendFeishuBox" Content="推送到飞书" />
              <TextBlock x:Name="ReportFeishuHint" Classes="hint" Margin="24,2,0,0"
                         Text="复用「提醒推送」里的飞书 webhook；未填则不会发送。" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Margin="0,0,0,10">
              <CheckBox x:Name="ReportSendWeComBox" Content="推送到企业微信" />
              <TextBlock x:Name="ReportWeComHint" Classes="hint" Margin="24,2,0,0"
                         Text="复用「提醒推送」里的企业微信 webhook；未填则不会发送。" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="自定义 webhook（可选，与上面两个渠道相互独立，勾了就会额外多发一条）"
                       Classes="fieldLabel" Margin="0,0,0,4" />
            <TextBox x:Name="ReportCustomWebhookBox" Classes="inputBox" Margin="0,0,0,6" />
            <TextBlock Classes="hint" Margin="0,0,0,10" TextWrapping="Wrap"
                       Text="留空则不发。自动识别飞书地址并用卡片推送，其他地址按企微 text 格式推送。" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="ReportPreviewButton" Content="预览报告" Classes="actionButton" Click="ReportPreview_Click" />
              <Button x:Name="ReportSendNowButton" Content="立即发送" Classes="actionButton" Margin="8,0,0,0" Click="ReportSendNow_Click" />
            </StackPanel>
            <TextBox x:Name="ReportPreviewBox" Height="180" Margin="0,10,0,0" IsReadOnly="True"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     FontSize="11.5" IsVisible="False" />
            <TextBlock x:Name="ReportActionStatus" Foreground="#157347" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- ===== 自动备份 ===== -->
        <Border x:Name="CardBackup" Classes="card">
          <StackPanel>
            <DockPanel Classes="cardHead">
              <Border DockPanel.Dock="Left" Classes="titleBar" />
              <TextBlock Text="自动备份" Classes="groupTitle" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <CheckBox x:Name="BackupEnabledBox" Content="启用自动备份" VerticalAlignment="Center" Margin="0,0,16,0" />
              <TextBlock Text="备份时间" Classes="fieldLabel" />
              <TextBox x:Name="BackupTimeBox" Width="70" Classes="inputBox" />
              <TextBlock Text="（HH:mm）" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="4,0,0,0" />
            </StackPanel>
            <TextBlock Text="每天到点自动导出全年任务 JSON，保存到本地。" Classes="hint" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <CheckBox x:Name="BackupSendFeishuBox" Content="备份后发送到飞书" VerticalAlignment="Center" Margin="0,0,16,0" />
              <CheckBox x:Name="BackupSendWeComBox" Content="备份后发送到企业微信" VerticalAlignment="Center" />
            </StackPanel>
            <WrapPanel Orientation="Horizontal">
              <Button x:Name="BackupNowButton" Content="立即备份" Classes="actionButton" Click="BackupNow_Click" />
              <Button Content="打开备份文件夹" Classes="actionButton" Margin="8,0,0,0" Click="OpenBackupFolder_Click" />
              <Button Content="导出 JSON" Classes="actionButton" Margin="8,0,0,0" Click="ExportJson_Click" />
              <Button Content="导入 JSON" Classes="actionButton" Margin="8,0,0,0" Click="ImportJson_Click" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- ===== MCP + my-mindmap 同步 ===== -->
        <Border x:Name="CardMcp" Classes="card">
          <StackPanel>
            <DockPanel Classes="cardHead">
              <Border DockPanel.Dock="Left" Classes="titleBar" />
              <TextBlock Text="MCP 接口（供外部 AI 客户端连接）" Classes="groupTitle" />
            </DockPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <CheckBox x:Name="McpEnabledBox" Content="启用 MCP" VerticalAlignment="Center" Margin="0,0,16,0" />
              <TextBlock Text="端口" Classes="fieldLabel" />
              <TextBox x:Name="McpPortBox" Width="80" Classes="inputBox" IsReadOnly="True" />
            </StackPanel>
            <TextBlock Text="MCP 端点地址" Classes="fieldLabel" Margin="0,0,0,4" />
            <TextBox x:Name="McpEndpointBox" Classes="inputBox" IsReadOnly="True" Margin="0,0,0,10" />
            <CheckBox x:Name="SyncMyMindMapBox" Margin="0,0,0,8"
                      Content="同步 my mind map agent（把 [MM复习] 任务的勾选状态实时同步回复习计划；删除任务不删除复习计划）" />
            <TextBlock Text="my mind map agent 本地 HTTP 地址" Classes="fieldLabel" Margin="0,0,0,4" />
            <TextBox x:Name="MindMapBaseUrlBox" Classes="inputBox" Margin="0,0,0,8" />
            <TextBlock Text="my mind map agent 本地 HTTP Token（端口 17800，不是 MCP Token）" Classes="fieldLabel" Margin="0,0,0,4" />
            <TextBox x:Name="MyMindMapTokenBox" Classes="inputBox" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
              <Button x:Name="TestMyMindMapButton" Content="测试连接" Classes="actionButton" Click="TestMyMindMap_Click" />
              <Button x:Name="SyncMindMapNowButton" Content="立即同步" Classes="actionButton" Margin="8,0,0,0" Click="SyncMindMapNow_Click" />
              <TextBlock x:Name="MyMindMapTestStatus" Foreground="#157347" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="SyncMindMapStatus" Foreground="#157347" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
            <Button Content="什么是 my mind map agent？（打开项目页）" Classes="actionButton"
                    HorizontalAlignment="Left" Margin="0,0,0,8" Click="OpenMindMapAgentProject_Click" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="CopySkillDocButton" Content="复制 Skill 文档" Classes="actionButton" Click="CopySkillDoc_Click" />
              <Button x:Name="CopyMcpConfigButton" Content="复制 MCP 配置 JSON" Classes="actionButton" Margin="8,0,0,0" Click="CopyMcpConfig_Click" />
            </StackPanel>
            <TextBlock Text="Claude Desktop / Cursor 等客户端添加 MCP Server 后，即可直接调用本程序的查询/增删改查任务等工具。"
                       Classes="hint" Margin="0,8,0,0" />
          </StackPanel>
        </Border>

        <!-- ===== AI 助手（OpenAI 兼容）===== -->
        <Border x:Name="CardAi" Classes="card">
          <StackPanel>
            <DockPanel Classes="cardHead">
              <Border DockPanel.Dock="Left" Classes="titleBar" />
              <TextBlock Text="AI 助手（OpenAI 兼容）" Classes="groupTitle" />
            </DockPanel>
            <CheckBox x:Name="AiEnabledBox" Margin="0,0,0,10"
                      Content="启用 AI 助手（顶栏对话窗 + 自然语言增删改查任务）" />
            <TextBlock Text="API URL（兼容 OpenAI 的接口地址，如 https://api.openai.com 或国内代理 /v1）" Classes="fieldLabel" Margin="0,0,0,4" />
            <TextBox x:Name="AiBaseUrlBox" Classes="inputBox" Margin="0,0,0,10" />
            <TextBlock Text="API Key" Classes="fieldLabel" Margin="0,0,0,4" />
            <TextBox x:Name="AiApiKeyBox" Classes="inputBox" Margin="0,0,0,10" />
            <TextBlock Text="模型（点击「检索模型」自动列出，也支持手动输入）" Classes="fieldLabel" Margin="0,0,0,4" />
            <Grid ColumnDefinitions="*,Auto">
              <ComboBox x:Name="AiModelBox" Grid.Column="0" IsEditable="True" VerticalAlignment="Center" />
              <Button x:Name="RetrieveAiModelsButton" Grid.Column="1" Content="检索模型" Classes="actionButton" Margin="8,0,0,0" Click="RetrieveAiModels_Click" />
            </Grid>
            <CheckBox x:Name="AiAutoCompleteUrlBox" Margin="0,10,0,0"
                      Content="自动补全链接（开启后自动检测 URL 是否完整，不完整时补全到 /v1/chat/completions）" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="TestAiButton" Content="测试连接" Classes="actionButton" Click="TestAiConnection_Click" />
              <TextBlock x:Name="AiStatus" Foreground="#157347" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ===== 桌面行为 ===== -->
        <Border x:Name="CardDesktop" Classes="card">
          <StackPanel>
            <DockPanel Classes="cardHead">
              <Border DockPanel.Dock="Left" Classes="titleBar" />
              <TextBlock Text="桌面行为" Classes="groupTitle" />
            </DockPanel>
            <CheckBox x:Name="EmbedDesktopBox" Content="嵌入桌面（置底模式：沉在其他窗口之下）" Margin="0,0,0,8" />
            <CheckBox x:Name="LockWindowBox" Content="锁定位置（禁止拖动 / 缩放）" Margin="0,0,0,8" />
            <!-- 开机启动两项是 Windows 专属（注册表 / 计划任务）：非 Windows 平台整块隐藏，
                 不给用户「点了没反应的开关」。 -->
            <StackPanel x:Name="StartupOptionsPanel" Spacing="4">
              <CheckBox x:Name="AutoStartBox" Content="开机自启动" />
              <CheckBox x:Name="HighPriorityBox" Content="高优先级开机启动（首次设置需要管理员授权）" />
              <TextBlock x:Name="HighPriorityStatus" Classes="hint" Margin="19,0,0,0"
                         Text="正在检查开机任务状态…" />
              <TextBlock Classes="hint" Margin="0,2,0,0"
                         Text="「开机自启动」不需要管理员权限；「高优先级启动」会登记一个开机计划任务，首次设置会弹出 UAC 授权框。" />
              <TextBlock Classes="hint" Margin="0,2,0,0"
                         Text="两条只保留一条：高优先级任务登记成功后，「开机自启动」的注册表项会自动让位——两条同时存在会让开机时启动两个程序。" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ===== 版本更新 ===== -->
        <Border x:Name="CardUpdate" Classes="card">
          <StackPanel>
            <DockPanel Classes="cardHead">
              <Border DockPanel.Dock="Left" Classes="titleBar" />
              <TextBlock Text="版本更新" Classes="groupTitle" />
            </DockPanel>
            <TextBlock x:Name="UpdateVersionText" Foreground="#374151" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
            <CheckBox x:Name="AutoCheckUpdateBox" Content="启动时自动检测更新" Margin="0,0,0,6" />
            <CheckBox x:Name="SkipUpdateTodayBox" Content="今日内不再提示更新" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="CheckUpdateButton" Content="检查更新" Classes="actionButton" Click="CheckUpdate_Click" />
              <TextBlock x:Name="UpdateStatusText" Foreground="#157347" FontSize="11" Margin="10,0,0,0"
                         VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Classes="hint" Margin="0,8,0,0"
                       Text="更新包取自 GitHub Releases：检测到新版本会先问一句，确认后在后台下载；下载完成再提示重启，重启后自动完成安装。" />
          </StackPanel>
        </Border>

        <!-- ===== 节假日数据 ===== -->
        <Border x:Name="CardHoliday" Classes="card">
          <StackPanel>
            <DockPanel Classes="cardHead">
              <Border DockPanel.Dock="Left" Classes="titleBar" />
              <TextBlock Text="节假日数据" Classes="groupTitle" />
            </DockPanel>
            <TextBlock Text="数据来自 timor.tech/api/holiday（每年首次进入时联网拉取，缓存 TTL 7 天）。国务院临时调休会在下次联网时自动同步。"
                       Classes="hint" Margin="0,0,0,8" />
            <TextBlock x:Name="HolidayStatusText" Foreground="#374151" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Text="读取中…" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Button x:Name="HolidayRefreshNowButton" Content="立即刷新" Classes="actionButton" Click="HolidayRefreshNow_Click" />
              <Button x:Name="HolidayClearCacheButton" Content="清空本地缓存" Classes="actionButton" Margin="8,0,0,0" Click="HolidayClearCache_Click" />
            </StackPanel>
            <TextBlock x:Name="HolidayRefreshStatus" Foreground="#157347" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- ===== 重置（危险操作，放在最后）===== -->
        <Border x:Name="CardReset" Classes="card" BorderBrush="#FCA5A5" BorderThickness="1">
          <StackPanel>
            <DockPanel Classes="cardHead">
              <Border DockPanel.Dock="Left" Classes="titleBar danger" />
              <TextBlock Text="重置" Classes="groupTitle" Foreground="#991B1B" />
            </DockPanel>
            <TextBlock Text="一键清空所有任务：删除数据库里的全部任务，并把右侧面板 / 日历格 / 本周统计 / 备份里的任务都清掉。重置后程序相当于新装状态，下次保存会自动落盘。"
                       Foreground="#7F1D1D" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal">
              <Button x:Name="DeleteAllTasksButton" Content="一键删除所有任务" Padding="14,7"
                      BorderThickness="1" BorderBrush="#DC2626" Background="#DC2626"
                      Foreground="#FFFFFF" FontWeight="SemiBold" Cursor="Hand" Click="DeleteAllTasks_Click" />
              <TextBlock x:Name="DeleteAllTasksStatus" Foreground="#157347" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ===== 底部固定操作条：不随内容滚动 ===== -->
    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#EDF0F3" BorderThickness="0,1,0,0" Padding="14,9">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="取消" Classes="actionButton" Click="Cancel_Click" Margin="0,0,8,0" />
        <Button Content="保存" Classes="primaryButton" Click="Save_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
