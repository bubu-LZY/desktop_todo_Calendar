<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MicaAgenda.Desktop.Controls.TimeField"
             Focusable="False">
  <!--
    任务时间输入：直接显示「时:分」两个小输入框，点哪改哪、滚轮 / 上下方向键微调，
    取代原来那个点开是一整块时钟面板的 TimePicker（用户反馈「很不像正常设置时间的 UI」）。
    外观在控件内部自给自足，主窗口与编辑任务窗口共用时不需要各自再配样式。
  -->
  <UserControl.Styles>
    <Style Selector="TextBox.tf">
      <Setter Property="Width" Value="22" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="IBeam" />
    </Style>
    <Style Selector="TextBox.tf:focus">
      <Setter Property="Background" Value="#EAF2FE" />
    </Style>
  </UserControl.Styles>

  <Border x:Name="Root" Height="24" MinWidth="86" CornerRadius="6"
          BorderThickness="1" BorderBrush="#CBD5E1" Background="#FFFFFF"
          Padding="5,0" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="0">
      <TextBox x:Name="HourBox" Classes="tf" Text="09" ToolTip.Tip="小时（0-23），滚轮 / ↑↓ 微调" />
      <TextBlock Text=":" FontSize="12" FontWeight="SemiBold" Foreground="#475569"
                 VerticalAlignment="Center" Margin="1,0" />
      <TextBox x:Name="MinuteBox" Classes="tf" Text="00" ToolTip.Tip="分钟（0-59），滚轮 / ↑↓ 微调" />
    </StackPanel>
  </Border>
</UserControl>
