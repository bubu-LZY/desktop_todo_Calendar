<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:MicaAgenda.Desktop.Converters"
        xmlns:ctl="using:MicaAgenda.Desktop.Controls"
        xmlns:vm="using:MicaAgenda.App.ViewModels"
        x:Class="MicaAgenda.Desktop.MainWindow"
        Width="980" Height="680"
        MinWidth="300" MinHeight="240"
        Title="{Binding Title}"
        WindowDecorations="None"
        Background="Transparent"
        Cursor="Arrow"
        SizeChanged="Window_SizeChanged"
        x:CompileBindings="False">

  <Window.Resources>
    <conv:TaskTitleOpacityConverter x:Key="TaskTitleOpacity" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:CompletedStrikethroughConverter x:Key="CompletedStrikethrough" />
    <conv:ShortDateConverter x:Key="ShortDate" />

    <!-- ===== 日格里的完成勾选框 =====
         Fluent 默认复选框是 20×20 的方框 + 32px 最小高度，一个日期格子里塞不下几条任务。
         这里换成自绘的 12×12 小方框：任务条的高度基本由它决定，压小它才能"一格看到更多任务"。 -->
    <ControlTheme x:Key="DayTaskCheckBox" TargetType="CheckBox">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Width="13" Height="13" Background="Transparent">
            <Border Name="Box" Width="12" Height="12" CornerRadius="3"
                    BorderThickness="1" BorderBrush="{DynamicResource TaskBorderBrush}"
                    Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Center">
              <Path Name="Glyph" Data="M 1,4.2 L 4,7 L 9.2,1.6"
                    Stroke="{DynamicResource WeekDoneCheckBrush}" StrokeThickness="1.6"
                    StrokeLineCap="Round" StrokeJoin="Round"
                    VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^ /template/ Path#Glyph">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="^:checked /template/ Path#Glyph">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:checked /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource TaskBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SelectedCellBorderBrush}" />
      </Style>
      <Style Selector="^:pointerover /template/ Border#Box">
        <Setter Property="BorderBrush" Value="{DynamicResource SelectedCellBorderBrush}" />
      </Style>
    </ControlTheme>

    <!-- ===== 背景模式调色板 =====
         下面的值是「浅色模式」的外观；切换背景模式时由 MainWindow.ApplyBackgroundResources()
         整体替换这些资源，XAML 里的 {DynamicResource} 会自动刷新。
         键名与 WPF 宿主 MicaAgenda.App/MainWindow.xaml 的资源字典保持一致，避免两个宿主漂移。 -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FF111827" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#FF6B7280" />
    <SolidColorBrush x:Key="CellBorderBrush" Color="#18000000" />
    <SolidColorBrush x:Key="TaskBorderBrush" Color="#33000000" />
    <SolidColorBrush x:Key="DayCellBackgroundBrush" Color="#AFFFFFFF" />
    <SolidColorBrush x:Key="DayCellOutMonthBackgroundBrush" Color="#6FFFFFFF" />
    <SolidColorBrush x:Key="TodayCellBackgroundBrush" Color="#BFDCEBFE" />
    <SolidColorBrush x:Key="TodayCellBorderBrush" Color="#993B82F6" />
    <SolidColorBrush x:Key="SelectedCellBackgroundBrush" Color="#662563EB" />
    <SolidColorBrush x:Key="SelectedCellBorderBrush" Color="#FF2563EB" />
    <SolidColorBrush x:Key="YearMonthBackgroundBrush" Color="#AFFFFFFF" />
    <SolidColorBrush x:Key="TaskBackgroundBrush" Color="#BAE9F7EF" />
    <SolidColorBrush x:Key="ImportantTaskBackgroundBrush" Color="#FFFECACA" />
    <SolidColorBrush x:Key="ImportantTaskBorderBrush" Color="#FFEF4444" />
    <SolidColorBrush x:Key="ImportantTaskTextBrush" Color="#FFB91C1C" />
    <SolidColorBrush x:Key="TodayPanelBackgroundBrush" Color="#AFFFFFFF" />
    <SolidColorBrush x:Key="TodayPanelBorderBrush" Color="#22000000" />
    <SolidColorBrush x:Key="HolidayBreakBrush" Color="#FFFEE2E2" />
    <SolidColorBrush x:Key="HolidayWorkBrush" Color="#FFDBEAFE" />
    <SolidColorBrush x:Key="HolidayTextBrush" Color="#FF991B1B" />
    <SolidColorBrush x:Key="HolidayWorkTextBrush" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="WeekGroupBackgroundBrush" Color="#8FFFFFFF" />
    <SolidColorBrush x:Key="WeekGroupHoverBrush" Color="#BFFFFFFF" />
    <SolidColorBrush x:Key="WeekTaskRowHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="WeekDoneCheckBrush" Color="#FF157347" />
    <SolidColorBrush x:Key="WindowEdgeBrush" Color="#28000000" />
    <SolidColorBrush x:Key="ToolbarControlBackgroundBrush" Color="#AFFFFFFF" />
    <SolidColorBrush x:Key="ToolbarControlBorderBrush" Color="#22000000" />
    <SolidColorBrush x:Key="ToolbarControlHoverBrush" Color="#DFFFFFFF" />
    <SolidColorBrush x:Key="ToolbarControlPressedBrush" Color="#CFE5E7EB" />

    <!-- ===== 任务胶囊模板（月/周日格共用）===== -->
    <DataTemplate x:Key="TaskTemplate" DataType="vm:TaskItemViewModel">
      <Border Classes="taskPill" Classes.important="{Binding IsImportant}"
              Margin="0,0.5" Padding="2,0" CornerRadius="3" BorderThickness="1"
              PointerPressed="TaskItem_PointerPressed"
              PointerMoved="TaskItem_PointerMoved"
              PointerReleased="TaskItem_PointerReleased"
              ToolTip.Tip="{Binding TooltipText}">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="标记为已完成" Click="CompleteTask_Click" />
            <MenuItem Header="标记为未完成" Click="IncompleteTask_Click" />
            <Separator />
            <MenuItem Header="标为重要" Click="ImportantTask_Click" />
            <MenuItem Header="取消重要" Click="UnimportantTask_Click" />
            <Separator />
            <MenuItem Header="编辑" Click="EditTask_Click" />
            <MenuItem Header="删除" Click="DeleteTask_Click" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid ColumnDefinitions="*,Auto">
          <!-- 显示态：序号 + 标记 + 时间 + 标题。标题独占一个 * 列，超长时才会省略号截断。
               整行共用一个 IsVisible，编辑时连同勾选框之外的内容一起让位给下面的输入框。 -->
          <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*"
                IsVisible="{Binding IsEditing, Converter={StaticResource InverseBool}}">
            <!-- 自动序号：跟着"未完成在前 → 重要优先 → 创建时间"的排序走，由 DayCellViewModel 统一写入 -->
            <TextBlock Grid.Column="0" Text="{Binding OrderText}" FontSize="8" MinWidth="9"
                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="★" Margin="0,0,2,0" FontSize="8.5" FontWeight="Bold"
                       Foreground="{DynamicResource ImportantTaskTextBrush}"
                       VerticalAlignment="Center" IsVisible="{Binding IsImportant}" />
            <TextBlock Grid.Column="3" Text="{Binding TaskTimeText}" FontSize="8" Margin="0,0,2,0"
                       ToolTip.Tip="任务时刻（没设时间默认 09:00）"
                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
            <!-- 已完成：不显示勾选框，标题直接加删除线、整体变淡；还原入口在行首悬停出现 -->
            <TextBlock Grid.Column="4" Classes="taskTitle" Classes.important="{Binding IsImportant}"
                       Text="{Binding Title}" FontSize="8.5" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Opacity="{Binding IsCompleted, Converter={StaticResource TaskTitleOpacity}}"
                       TextDecorations="{Binding IsCompleted, Converter={StaticResource CompletedStrikethrough}}" />
          </Grid>
          <!-- 右侧状态位：未完成 = 小勾选框；已完成 = 悬停才浮现的还原箭头（平时完全不占位干扰） -->
          <Grid Grid.Column="1" Width="15" Margin="2,0,0,0" VerticalAlignment="Center">
            <CheckBox Theme="{StaticResource DayTaskCheckBox}"
                      IsChecked="{Binding IsCompleted, Mode=OneWay}"
                      IsCheckedChanged="TaskCheckBox_Changed"
                      IsVisible="{Binding IsCompleted, Converter={StaticResource InverseBool}}" />
            <Button Classes="rowRestore" Content="↺" FontSize="9"
                    IsVisible="{Binding IsCompleted}"
                    Click="RestoreTask_Click"
                    ToolTip.Tip="还原为未完成" />
          </Grid>
          <TextBox Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding EditTitle}"
                   IsVisible="{Binding IsEditing}" FontSize="10" Padding="3,1" MinHeight="18"
                   KeyDown="TaskEditTextBox_KeyDown" LostFocus="TaskEditTextBox_LostFocus" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- ===== 日期格子模板（月视图用）===== -->
    <DataTemplate x:Key="DayCellTemplate" DataType="vm:DayCellViewModel">
      <Border CornerRadius="6" Height="96" Margin="1" Padding="4"
              Classes="dayCell" Classes.outmonth="{Binding IsOutMonth}"
              Classes.today="{Binding IsToday}" Classes.selected="{Binding IsSelected}"
              PointerPressed="DayCell_PointerPressed">
        <Grid RowDefinitions="Auto,*,Auto">
          <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Right" Text="{Binding TaskCount}" FontSize="10"
                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0"
                       IsVisible="{Binding HasTasks}" />
            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Holidays}"
                          IsVisible="{Binding HasHolidays}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="holidayBadge" Classes.workday="{Binding IsMakeupWorkday}"
                          CornerRadius="4" Margin="3,0,0,0" Padding="4,0" Height="18">
                    <TextBlock Classes="holidayText" Text="{Binding BadgeText}" FontSize="11"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- 选中格子才暴露“+”快速新增 -->
            <Button DockPanel.Dock="Right" Content="+" FontSize="16" FontWeight="Bold"
                    Width="22" Height="22" Padding="0" Margin="4,0,0,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Click="AddTaskOnSelectedCell_Click" IsVisible="{Binding IsSelected}" />
            <TextBlock Text="{Binding DayNumber}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" />
          </DockPanel>
          <ScrollViewer Grid.Row="1" Margin="0,3,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TaskTemplate}" />
          </ScrollViewer>
          <!-- 格子里点「+」后弹出的快速添加表单。
               格子本身只有 ~96px 高，塞不下「标题 + 提醒时间 + 按钮」，
               所以用一个跟着格子走的悬浮层（Popup）展开，而不是把小格子撑高。 -->
          <Popup Grid.Row="0" Grid.RowSpan="3"
                 IsOpen="{Binding IsAddingTask}" PlacementTarget="{Binding $parent[Border]}"
                 Placement="BottomEdgeAlignedLeft" HorizontalOffset="-2" VerticalOffset="4"
                 IsLightDismissEnabled="False">
            <Border Classes="panel" CornerRadius="8" Padding="8,7" BorderThickness="1" Width="216"
                    Tag="CellAddForm">
              <StackPanel Spacing="5">
                <!-- 表头：左边日期，右边直接显示「时:分」，点哪改哪。
                     选中的时刻就是这条任务的时刻；下面的「提醒时间」相对它往前推。 -->
                <DockPanel LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{Binding Header}" FontSize="11" FontWeight="SemiBold"
                             Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                  <ctl:TimeField DockPanel.Dock="Right" Tag="CellTimeBox"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Time="{Binding DraftTime, Mode=TwoWay}"
                                 ToolTip.Tip="任务时刻，默认 09:00（滚轮 / ↑↓ 微调，Shift 分钟步进 1）" />
                </DockPanel>
                <TextBox Tag="CellDraftBox" Text="{Binding DraftTitle}"
                         Padding="4,3" FontSize="11.5" MinHeight="22"
                         PlaceholderText="任务内容，回车添加"
                         KeyDown="InlineTaskTextBox_KeyDown" />
                <Grid ColumnDefinitions="Auto,*">
                  <TextBlock Grid.Column="0" Text="提醒时间" FontSize="10.5" Margin="0,0,5,0"
                             Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                  <ctl:ReminderLeadPicker Grid.Column="1" Tag="CellLeadBox"
                                          HorizontalAlignment="Left"
                                          SelectedLabels="{Binding ReminderLeadLabels}"
                                          FirstLeadSelected="CellLeadPicker_FirstSelected" />
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                  <Button Content="取消" FontSize="10.5" Padding="8,2" MinHeight="0"
                          Click="CellCancelAdd_Click" />
                  <Button Content="确定" FontSize="10.5" Padding="10,2" MinHeight="0"
                          Click="CellCommitAdd_Click" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>
      </Border>
    </DataTemplate>

  <!-- ===== 周视图左栏的日期格子（竖排）=====
       布局约定（用户明确要求）：
       - **宽度固定**为 WeekScrollColumnWidth(132)，不随窗口缩放变化；
         调窗口大小时变的是右侧「今日任务」面板宽度，左栏纹丝不动。
       - **高度自适应**：由宿主按「左栏可用高度 ÷ 7」算出 WeekScrollCellHeight 回填，
         让 7 个格子刚好铺满界面高度，纵向不留空。
       → 所以格子是「定宽 + 变高」的矩形，不再强行做成正方形
         （正方形会让格子左右两侧留出大片空白，而右面板反被挤窄）。
       内容仍是「日 + 星期」+ 当天任务条，任务多时格子内部自己滚动而不是把格子撑高。
       整列可上下滚动：默认停在开头（最近 7 天），往下滚看到后面日期的格子。
       尺寸改动时记得同步 MicaAgenda.App/MainWindow.xaml 的同名模板。 -->
  <DataTemplate x:Key="WeekDayRowTemplate" DataType="vm:DayCellViewModel">
    <!-- 宽度用常量、高度绑 ViewModel 回填值。
         这里用 $parent[Window].DataContext 取回 MainViewModel：格子模板的 DataContext 是
         DayCellViewModel，拿不到宿主的尺寸属性，必须沿视觉树往上找到 Window。
         x:CompileBindings 在本文件已关，所以不需要写类型转换。 -->
    <Border Width="132"
            Height="{Binding $parent[Window].DataContext.WeekScrollCellHeight}"
            CornerRadius="6" Margin="0,0,0,4" Padding="5,4"
            Classes="weekDayRow"
            Classes.outmonth="{Binding IsOutMonth}"
            Classes.today="{Binding IsToday}"
            Classes.selected="{Binding IsSelected}"
            PointerPressed="DayCell_PointerPressed">
      <Grid RowDefinitions="Auto,*">
        <!-- 行首：「日 + 星期」，选中时右侧出现 + 号（与月视图格子的规则一致） -->
        <DockPanel Grid.Row="0" LastChildFill="False">
          <Button DockPanel.Dock="Right" Content="+" FontSize="12" FontWeight="Bold"
                  Width="17" Height="17" MinWidth="0" Padding="0" Margin="3,0,0,0"
                  VerticalAlignment="Center"
                  Click="AddTaskOnSelectedCell_Click" IsVisible="{Binding IsSelected}"
                  ToolTip.Tip="给这一天添加任务" />
          <TextBlock DockPanel.Dock="Right" Text="{Binding TaskCount}" FontSize="9"
                     Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                     Margin="3,0,0,0" IsVisible="{Binding HasTasks}" />
          <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Holidays}"
                        VerticalAlignment="Center" IsVisible="{Binding HasHolidays}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="holidayBadge" Classes.workday="{Binding IsMakeupWorkday}"
                        CornerRadius="3" Margin="2,0,0,0" Padding="3,0" Height="14">
                  <TextBlock Classes="holidayText" Text="{Binding BadgeText}" FontSize="9"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- 日期块本身就是一个「日期 + 星期」的短标签 -->
          <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding DayNumber}" FontWeight="SemiBold" FontSize="11.5"
                       Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding WeekdayLabel}" FontSize="9.5"
                       Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
          </StackPanel>
        </DockPanel>
        <!-- 当天任务：格子高度固定，任务多时在格子内部滚动，不把格子撑高（保证正方形） -->
        <ScrollViewer Grid.Row="1" Margin="0,2,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TaskTemplate}" />
        </ScrollViewer>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- ===== 月份块模板（时间轴）===== -->
  <DataTemplate x:Key="MonthBlockTemplate" DataType="vm:MonthBlockViewModel">
      <StackPanel Margin="0,0,0,12">
        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"
                   Margin="6,4,0,6" />
        <UniformGrid Columns="7" Margin="4,0,4,2">
          <TextBlock Text="日" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
          <TextBlock Text="一" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
          <TextBlock Text="二" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
          <TextBlock Text="三" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
          <TextBlock Text="四" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
          <TextBlock Text="五" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
          <TextBlock Text="六" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
        </UniformGrid>
        <ItemsControl ItemsSource="{Binding Days}" ItemTemplate="{StaticResource DayCellTemplate}" Margin="4,0,4,2">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="7" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <!-- ===== 年视图月份块模板 ===== -->
    <DataTemplate x:Key="YearMonthTemplate" DataType="vm:MonthSummaryViewModel">
      <Border Classes="card" BorderThickness="1"
              CornerRadius="7" Margin="4" Padding="6">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="{Binding TaskCount}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                       VerticalAlignment="Center" Margin="6,1,0,0" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="7" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:DayCellViewModel">
                <Border Classes="yearCell" Classes.outmonth="{Binding IsOutMonth}"
                        Classes.today="{Binding IsToday}" Classes.selected="{Binding IsSelected}"
                        Height="24" Margin="1" Padding="3" CornerRadius="4"
                        PointerPressed="DayCell_PointerPressed">
                  <Grid>
                    <!-- 字号绑定 VM 回填值：窗口缩小时月卡列宽变小，
                         字号不同步缩小的话两位日期数字会被节日徽标盖住/裁掉
                         （宿主 UpdateResponsiveLayout 按实际列宽回填，见 SetYearFontScale）。 -->
                    <TextBlock Text="{Binding DayNumber}"
                               FontSize="{Binding $parent[Window].DataContext.YearDayFontSize, FallbackValue=11}"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                      <TextBlock Text="{Binding FirstHolidayBadge}"
                                 FontSize="{Binding $parent[Window].DataContext.YearBadgeFontSize, FallbackValue=9}"
                                 FontWeight="Bold"
                                 Foreground="{DynamicResource HolidayTextBrush}" Margin="0,0,3,0" IsVisible="{Binding HasHolidays}" />
                      <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center"
                               IsVisible="{Binding HasTasks}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- ===== 右侧面板：今日任务条目（复选框 + 标题/时间徽标 + 行内编辑 + 右键菜单）===== -->
    <DataTemplate x:Key="TodayTaskItemTemplate" DataType="vm:TaskItemViewModel">
      <Border Classes="taskPill" Classes.important="{Binding IsImportant}"
              Margin="0,0,0,4" Padding="5,4" CornerRadius="5" BorderThickness="1"
              Opacity="{Binding IsCompleted, Converter={StaticResource TaskTitleOpacity}}"
              ToolTip.Tip="{Binding TooltipText}"
              PointerPressed="TodayTaskItem_PointerPressed">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="标记为已完成" Click="CompleteTask_Click" />
            <MenuItem Header="标记为未完成" Click="IncompleteTask_Click" />
            <Separator />
            <MenuItem Header="标为重要" Click="ImportantTask_Click"
                      IsVisible="{Binding IsImportant, Converter={StaticResource InverseBool}}" />
            <MenuItem Header="取消重要" Click="UnimportantTask_Click"
                      IsVisible="{Binding IsImportant}" />
            <Separator />
            <MenuItem Header="编辑" Click="EditTask_Click" />
            <MenuItem Header="删除" Click="DeleteTask_Click" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid ColumnDefinitions="Auto,*">
          <!-- 未完成：勾选框；已完成：勾选框消失，行首悬停浮现 ↺ 还原（平时整行只剩删除线文字） -->
          <Grid Grid.Column="0" Width="16" Margin="1,2,5,0" VerticalAlignment="Top">
            <CheckBox Theme="{StaticResource DayTaskCheckBox}"
                      IsChecked="{Binding IsCompleted, Mode=OneWay}"
                      IsCheckedChanged="TaskCheckBox_Changed"
                      IsVisible="{Binding IsCompleted, Converter={StaticResource InverseBool}}" />
            <Button Classes="rowRestore" Content="↺" FontSize="11"
                    IsVisible="{Binding IsCompleted}"
                    Click="RestoreTask_Click"
                    ToolTip.Tip="还原为未完成" />
          </Grid>
          <StackPanel Grid.Column="1" IsVisible="{Binding IsEditing, Converter={StaticResource InverseBool}}">
            <TextBlock Classes="taskTitle" Classes.important="{Binding IsImportant}"
                       Text="{Binding Title}" FontSize="11.5" TextWrapping="Wrap"
                       TextDecorations="{Binding IsCompleted, Converter={StaticResource CompletedStrikethrough}}" />
            <TextBlock Text="{Binding TimeBadge}" FontSize="9.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,0" />
          </StackPanel>
          <TextBox Grid.Column="1" Text="{Binding EditTitle}" IsVisible="{Binding IsEditing}"
                   AcceptsReturn="True" TextWrapping="Wrap" Padding="3,2" FontSize="11.5"
                   KeyDown="TaskEditTextBox_KeyDown" LostFocus="TaskEditTextBox_LostFocus" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- ===== 右侧面板：本周任务行（复选框 + 日期 + 标题/徽标 + 完成勾）
         「逾期未完成」已并入「未完成」一组：逾期任务只在标题前多一段红色【已逾期】。 ===== -->
    <DataTemplate x:Key="WeekTaskItemTemplate" DataType="vm:TaskItemViewModel">
      <Border Classes="weekRow" Classes.important="{Binding IsImportant}" ToolTip.Tip="{Binding TooltipText}" PointerPressed="WeekTaskRow_PointerPressed">
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="标记为已完成" Click="CompleteTask_Click" />
            <MenuItem Header="标记为未完成" Click="IncompleteTask_Click" />
            <Separator />
            <MenuItem Header="标为重要" Click="ImportantTask_Click"
                      IsVisible="{Binding IsImportant, Converter={StaticResource InverseBool}}" />
            <MenuItem Header="取消重要" Click="UnimportantTask_Click"
                      IsVisible="{Binding IsImportant}" />
            <Separator />
            <MenuItem Header="编辑" Click="EditTask_Click" />
            <MenuItem Header="删除" Click="DeleteTask_Click" />
          </ContextMenu>
        </Border.ContextMenu>
        <Grid ColumnDefinitions="20,32,*">
          <!-- 未完成：勾选框；已完成：勾选框消失，悬停该行时行首浮现 ↺ 还原 -->
          <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,2,0">
            <CheckBox Theme="{StaticResource DayTaskCheckBox}"
                      IsChecked="{Binding IsCompleted, Mode=OneWay}"
                      IsCheckedChanged="TaskCheckBox_Changed"
                      IsVisible="{Binding IsCompleted, Converter={StaticResource InverseBool}}" />
            <Button Classes="rowRestore" Content="↺" FontSize="10"
                    IsVisible="{Binding IsCompleted}"
                    Click="RestoreTask_Click"
                    ToolTip.Tip="还原为未完成" />
          </Grid>
          <TextBlock Grid.Column="1" Text="{Binding Date, Converter={StaticResource ShortDate}}" FontSize="10.5"
                     Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"
                     Opacity="{Binding IsCompleted, Converter={StaticResource TaskTitleOpacity}}" />
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,4,0">
            <!-- 标题行：逾期任务前置红色【已逾期】，与标题同一行、不换行；已完成整行删除线、自动沉到该日最后 -->
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding OverduePrefix}" FontSize="10.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource ImportantTaskTextBrush}"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="taskTitle" Classes.important="{Binding IsImportant}"
                         Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"
                         Opacity="{Binding IsCompleted, Converter={StaticResource TaskTitleOpacity}}"
                         TextDecorations="{Binding IsCompleted, Converter={StaticResource CompletedStrikethrough}}" />
            </StackPanel>
            <TextBlock Text="{Binding TimeBadge}" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- ===== 右侧面板主体：选中日期任务（未完成/已完成）+ 本周任务完成情况（三组）===== -->
    <DataTemplate x:Key="RightPanelTemplate" DataType="vm:MainViewModel">
      <Border Classes="panel" CornerRadius="8" Padding="8,7" BorderThickness="1">
        <Grid RowDefinitions="Auto,Auto,*">
          <!-- 顶部：标题 + 清空 / + -->
          <DockPanel Grid.Row="0" Margin="0,0,0,4" LastChildFill="False">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="清空" FontSize="10" Padding="6,2" Margin="4,0,0,0"
                      Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource MutedTextBrush}" Foreground="{DynamicResource MutedTextBrush}"
                      ToolTip.Tip="删除这一天的所有任务（不可撤销）"
                      Click="ClearPanelDate_Click" IsVisible="{Binding HasTodayTasks}" />
              <Button Content="+" Width="22" Height="22" FontSize="15" FontWeight="Bold" Padding="0" Margin="4,0,0,0"
                      Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}" Click="AddTodayTask_Click" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding PanelHeader}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
              <TextBlock Text="{Binding TodayTaskSummary}" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
          <!-- ===== 快速添加表单（紧凑单行）：输入框 + 任务时间小按钮 + 提醒小按钮 =====
               时间与提醒不再各占一行、说明也不再单独一行 —— 右侧面板宽度有限，
               三行设置 + 一行说明把任务列表挤没了。现在：
               · 输入框右边两个小按钮：「HH:mm」点开浮层改时刻；「不提醒/摘要」是
                 ReminderLeadPicker 的紧凑模式（Compact），点开选档位；
               · 说明文字分别挪进两个弹层里（时间微调提示 / 档位说明）。
               用 Tag 而不是 x:Name 定位：这段在 DataTemplate 内部，x:Name 生成不了字段
               （模板有自己的命名空间），宿主里既有右侧面板又有窄窗视图两份实例。 -->
          <StackPanel Grid.Row="1" Tag="AddTaskForm" IsVisible="{Binding IsAddingTodayTask}"
                      Margin="0,0,0,5" Spacing="4">
            <Grid ColumnDefinitions="*,Auto,Auto">
              <TextBox Grid.Column="0" Tag="TodayTaskDraftBox" Text="{Binding TodayTaskDraft}"
                       Padding="4,3" FontSize="11.5" MinHeight="22"
                       PlaceholderText="输入任务，回车添加"
                       KeyDown="TodayTaskTextBox_KeyDown" LostFocus="TodayTaskTextBox_LostFocus" />
              <!-- 任务时间：小按钮直接显示当前时刻，点开浮层修改（滚轮 / ↑↓ 微调）
                   用 x:Name + #TimeToggle 引用而不是 $parent：Popup 是 ToggleButton 的逻辑子元素、
                   不在其视觉祖先链上，$parent[ToggleButton] 解析不到（弹层永远打不开）。
                   CompileBindings=False，所以 #Name 运行时引用可用。
                   IsCheckedChanged 通知宿主"时间弹层开/关"，用来抑制「失焦提交」——
                   否则点按钮瞬间输入框失焦、焦点还没进弹层，表单就被误提交收起。 -->
              <ToggleButton x:Name="TimeToggle" Grid.Column="1" Classes="chip" Content="{Binding TodayTaskTimeText}"
                            Height="22" Padding="6,0" FontSize="10" CornerRadius="6" Margin="3,0,0,0"
                            VerticalAlignment="Center"
                            IsCheckedChanged="TodayTimeToggle_IsCheckedChanged"
                            ToolTip.Tip="任务时刻，默认 09:00（点击修改）">
                <Popup IsOpen="{Binding #TimeToggle.IsChecked, Mode=TwoWay}"
                       Placement="Bottom" PlacementTarget="{Binding #TimeToggle}"
                       VerticalOffset="3" IsLightDismissEnabled="True">
                  <!-- 弹层里也带 AddTaskForm 标记：焦点判定把弹层内当表单内，不会误提交 -->
                  <Border Classes="panel" CornerRadius="8" Padding="8" BorderThickness="1" Tag="AddTaskForm">
                    <StackPanel Spacing="4">
                      <ctl:TimeField Tag="TodayTimeBox" Time="{Binding TodayTaskTime, Mode=TwoWay}"
                                     HorizontalAlignment="Left" />
                      <TextBlock Text="滚轮 / ↑↓ 微调，Shift 分钟步进 1；改完点外面收起"
                                 FontSize="9.5" TextWrapping="Wrap" MaxWidth="180"
                                 Foreground="{DynamicResource MutedTextBrush}" />
                    </StackPanel>
                  </Border>
                </Popup>
              </ToggleButton>
              <!-- 提醒时间：多选下拉的紧凑模式（弹层里带档位说明） -->
              <ctl:ReminderLeadPicker Grid.Column="2" Tag="TaskLeadBox" Compact="True"
                                      Margin="3,0,0,0"
                                      VerticalAlignment="Center"
                                      ToolTip.Tip="提醒按「任务时间」往前推，可多选；一个都不勾＝不提醒"
                                      SelectedLabels="{Binding TodayTaskLeadLabels}"
                                      FirstLeadSelected="TodayLeadPicker_FirstSelected" />
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
              <Button Content="取消" FontSize="10.5" Padding="8,2" MinHeight="0" Click="CancelTodayTask_Click" />
              <Button Content="确定" FontSize="10.5" Padding="10,2" MinHeight="0" Click="CommitTodayTask_Click" />
            </StackPanel>
          </StackPanel>
          <!-- 任务列表 + 本周完成情况 -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <StackPanel IsVisible="{Binding HasTodayOpen}">
                <TextBlock Text="{Binding TodayTaskPending, StringFormat=未完成 ({0})}" FontSize="10.5"
                           FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,2" />
                <ItemsControl ItemsSource="{Binding TodayOpenTasks}" ItemTemplate="{StaticResource TodayTaskItemTemplate}" />
              </StackPanel>
              <StackPanel Margin="0,6,0,0" IsVisible="{Binding HasTodayCompleted}">
                <TextBlock Text="已完成" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,2,0,2" />
                <ItemsControl ItemsSource="{Binding TodayCompletedTasks}" ItemTemplate="{StaticResource TodayTaskItemTemplate}" />
              </StackPanel>
              <TextBlock Text="还没有任务，点右上角 + 添加一条" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"
                         TextWrapping="Wrap" TextAlignment="Center" Margin="2,6,2,4"
                         IsVisible="{Binding HasTodayTasks, Converter={StaticResource InverseBool}}" />

              <Border Classes="panel" Margin="0,10,0,0" Padding="8,7" CornerRadius="9" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="本周任务完成情况" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" />
                  <TextBlock Text="{Binding WeekSummary}" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}"
                             Margin="0,2,0,0" TextWrapping="Wrap" />

                  <!-- ① 未完成（逾期欠账排在前面，行内挂红色【已逾期】前缀，不再单列一组） -->
                  <Border Classes="weekGroup">
                    <StackPanel>
                      <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Classes="weekIcon" Content="✕" Foreground="{DynamicResource ImportantTaskTextBrush}"
                                  ToolTip.Tip="一键删除全部未完成任务（含逾期欠账）" Click="ClearOpenTasks_Click" />
                          <Button Classes="weekIcon" Content="✓" Foreground="{DynamicResource WeekDoneCheckBrush}"
                                  ToolTip.Tip="一键把所有未完成任务标记为已完成（含逾期欠账）" Click="MarkOpenCompleted_Click" />
                          <TextBlock Margin="6,0,0,0" Text="{Binding WeekOpenCount, StringFormat=({0})}"
                                     FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                          <TextBlock Text="未完成" FontSize="10.5" FontWeight="SemiBold"
                                     Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding WeekOverdueCount, StringFormat=N 项已逾期({0})}"
                                     FontSize="9.5" FontWeight="SemiBold"
                                     Foreground="{DynamicResource ImportantTaskTextBrush}" VerticalAlignment="Center"
                                     IsVisible="{Binding HasWeekOverdue}"
                                     ToolTip.Tip="含已经过了任务时刻、仍未完成的历史欠账" />
                        </StackPanel>
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding WeekOpenTasks}" ItemTemplate="{StaticResource WeekTaskItemTemplate}" />
                      <TextBlock Text="没有未完成任务（逾期欠账也会显示在这一组）" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}"
                                 Margin="2,2,0,0" IsVisible="{Binding HasWeekOpen, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                  </Border>

                  <!-- ③ 已完成 -->
                  <Border Classes="weekGroup">
                    <StackPanel>
                      <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Classes="weekIcon" Content="✕" Foreground="{DynamicResource ImportantTaskTextBrush}"
                                  ToolTip.Tip="一键删除全部本周已完成的任务" Click="ClearCompletedTasks_Click" />
                          <Button Classes="weekIcon" Content="↺" Foreground="#2563EB"
                                  ToolTip.Tip="一键把本周已完成任务还原为未完成" Click="MarkCompletedIncomplete_Click" />
                          <TextBlock Margin="6,0,0,0" Text="{Binding WeekCompletedCount, StringFormat=({0})}"
                                     FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="已完成" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                      </DockPanel>
                      <ItemsControl ItemsSource="{Binding WeekCompletedTasks}" ItemTemplate="{StaticResource WeekTaskItemTemplate}" />
                      <TextBlock Text="本周内已完成的任务" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}"
                                 Margin="2,2,0,0" IsVisible="{Binding HasWeekCompleted, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <!-- 本周任务行：紧凑、悬停高亮（Avalonia 无 DataTrigger，用 :pointerover 选择器） -->
    <Style Selector="Border.weekRow">
      <Setter Property="Margin" Value="0,0,0,2" />
      <Setter Property="Padding" Value="4,3" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.weekRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource WeekTaskRowHoverBrush}" />
    </Style>
    <!-- 本周三个分组的卡片 -->
    <Style Selector="Border.weekGroup">
      <Setter Property="Margin" Value="0,7,0,0" />
      <Setter Property="Padding" Value="7,6" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource TodayPanelBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource WeekGroupBackgroundBrush}" />
    </Style>
    <Style Selector="Border.weekGroup:pointerover">
      <Setter Property="Background" Value="{DynamicResource WeekGroupHoverBrush}" />
    </Style>
    <!-- 分组标题右侧的批量图标按钮 -->
    <Style Selector="Button.weekIcon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ===== 调色板样式：日期格子 / 任务胶囊 / 面板 / 节假日徽标 =====
         颜色全部走 DynamicResource，切换背景模式时由 ApplyBackgroundResources() 换掉资源即整体生效。
         状态类（outmonth / today / selected / important / workday）由 Classes.xxx="{Binding}" 条件挂载，
         顺序即优先级：后面的样式覆盖前面的（selected > today > outmonth）。 -->
    <Style Selector="Border.dayCell">
      <Setter Property="Background" Value="{DynamicResource DayCellBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CellBorderBrush}" />
      <Setter Property="BorderThickness" Value="0.5" />
    </Style>
    <Style Selector="Border.dayCell.outmonth">
      <Setter Property="Background" Value="{DynamicResource DayCellOutMonthBackgroundBrush}" />
      <Setter Property="Opacity" Value="0.46" />
    </Style>
    <Style Selector="Border.dayCell.today">
      <Setter Property="Background" Value="{DynamicResource TodayCellBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TodayCellBorderBrush}" />
      <Setter Property="BorderThickness" Value="1.2" />
    </Style>
    <Style Selector="Border.dayCell.selected">
      <Setter Property="Background" Value="{DynamicResource SelectedCellBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SelectedCellBorderBrush}" />
      <Setter Property="BorderThickness" Value="1.6" />
    </Style>
    <!-- 周视图左栏的日期行：与 dayCell 同一套配色语义（今天 / 选中 / 非本月），
         只是形状从正方形格子变成一行。行高不设死，由当天任务条数自然撑开。 -->
    <Style Selector="Border.weekDayRow">
      <Setter Property="Background" Value="{DynamicResource DayCellBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CellBorderBrush}" />
      <Setter Property="BorderThickness" Value="0.5" />
      <!-- 高度完全交给 WeekScrollCellHeight（宿主按「可用高度 ÷ 7」回填）控制，
           这里不设 MinHeight —— 残留的下限会在矮窗口里反向把格子撑高，
           导致「7 格铺满」算出来的高度失效、整列溢出。 -->
    </Style>
    <Style Selector="Border.weekDayRow.outmonth">
      <Setter Property="Background" Value="{DynamicResource DayCellOutMonthBackgroundBrush}" />
      <Setter Property="Opacity" Value="0.46" />
    </Style>
    <Style Selector="Border.weekDayRow.today">
      <Setter Property="Background" Value="{DynamicResource TodayCellBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TodayCellBorderBrush}" />
      <Setter Property="BorderThickness" Value="1.2" />
    </Style>
    <Style Selector="Border.weekDayRow.selected">
      <Setter Property="Background" Value="{DynamicResource SelectedCellBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SelectedCellBorderBrush}" />
      <Setter Property="BorderThickness" Value="1.6" />
    </Style>
    <!-- 年视图里的小格子：不画边框，只换底色 -->
    <Style Selector="Border.yearCell">
      <Setter Property="Background" Value="{DynamicResource DayCellBackgroundBrush}" />
    </Style>
    <Style Selector="Border.yearCell.outmonth">
      <Setter Property="Background" Value="{DynamicResource DayCellOutMonthBackgroundBrush}" />
      <Setter Property="Opacity" Value="0.46" />
    </Style>
    <Style Selector="Border.yearCell.today">
      <Setter Property="Background" Value="{DynamicResource TodayCellBackgroundBrush}" />
    </Style>
    <Style Selector="Border.yearCell.selected">
      <Setter Property="Background" Value="{DynamicResource SelectedCellBackgroundBrush}" />
    </Style>
    <!-- 年视图月份块 -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource YearMonthBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CellBorderBrush}" />
    </Style>
    <!-- 右侧任务面板 / 本周完成情况卡片 -->
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="{DynamicResource TodayPanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TodayPanelBorderBrush}" />
    </Style>
    <!-- 任务胶囊（月/周日格 + 右侧面板条目共用） -->
    <Style Selector="Border.taskPill">
      <Setter Property="Background" Value="{DynamicResource TaskBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TaskBorderBrush}" />
    </Style>
    <Style Selector="Border.taskPill.important">
      <Setter Property="Background" Value="{DynamicResource ImportantTaskBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ImportantTaskBorderBrush}" />
    </Style>
    <Style Selector="TextBlock.taskTitle">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="Border.taskPill.important TextBlock.taskTitle">
      <Setter Property="Foreground" Value="{DynamicResource ImportantTaskTextBrush}" />
    </Style>
    <Style Selector="Border.weekRow.important TextBlock.taskTitle">
      <Setter Property="Foreground" Value="{DynamicResource ImportantTaskTextBrush}" />
    </Style>
    <!-- 节假日徽标（补班日走蓝色系） -->
    <Style Selector="Border.holidayBadge">
      <Setter Property="Background" Value="{DynamicResource HolidayBreakBrush}" />
    </Style>
    <Style Selector="Border.holidayBadge.workday">
      <Setter Property="Background" Value="{DynamicResource HolidayWorkBrush}" />
    </Style>
    <Style Selector="Border.holidayBadge TextBlock.holidayText">
      <Setter Property="Foreground" Value="{DynamicResource HolidayTextBrush}" />
    </Style>
    <Style Selector="Border.holidayBadge.workday TextBlock.holidayText">
      <Setter Property="Foreground" Value="{DynamicResource HolidayWorkTextBrush}" />
    </Style>
    <!-- 顶栏按钮：紧凑小尺寸（高度 24、字号 11.5），深色模式下也不能是一排浅色按钮。
         必须显式钉死两个 ContentAlignment：Fluent Button 模板里 ContentPresenter 默认
         HorizontalContentAlignment=Stretch、内容靠左，表现就是「今天 / 设置」文字偏左、
         右侧空出一块。 -->
    <Style Selector="Button.toolbar">
      <Setter Property="Height" Value="24" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{DynamicResource ToolbarControlBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToolbarControlBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <!-- 窄窗时的两级紧凑档：顶栏入口在窄屏下都不可缺（窄屏正是任务视图，最需要加任务 / 开设置），
         所以只能逐级缩字号与内边距，不能隐藏。由 UpdateResponsiveLayout 按实测宽度自动切换。 -->
    <Style Selector="Button.toolbar.compact">
      <Setter Property="Height" Value="21" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="FontSize" Value="10" />
    </Style>
    <Style Selector="Button.toolbar.ultra">
      <Setter Property="Height" Value="19" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="FontSize" Value="9" />
    </Style>
    <!-- 锁定按钮按下后的"已锁"态：边框/字换成提醒色，一眼能看出当前是锁住的 -->
    <Style Selector="Button.toolbar.locked">
      <Setter Property="Foreground" Value="{DynamicResource ImportantTaskTextBrush}" />
      <Setter Property="BorderBrush" Value="#66EF4444" />
    </Style>
    <Style Selector="Button.toolbar /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ToolbarControlBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToolbarControlBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ToolbarControlHoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToolbarControlBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>
    <Style Selector="Button.toolbar:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ToolbarControlPressedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ToolbarControlBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <!-- ===== 已完成任务的「↺ 还原」小按钮 =====
         默认透明（只在已完成行里存在），鼠标悬停整行时柔和浮现；
         不画边框底色，避免在已经变淡的删除线行上又出现一个扎眼的方块。 -->
    <Style Selector="Button.rowRestore">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.rowRestore /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- 鼠标进入整行（或按钮自身）时浮现 -->
    <Style Selector="Border.weekRow:pointerover Button.rowRestore">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Border.taskPill:pointerover Button.rowRestore">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.rowRestore:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.rowRestore:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Foreground" Value="{DynamicResource ImportantTaskTextBrush}" />
    </Style>

    <!-- ===== 全局柔和化：背景色变化都走 120ms 过渡，悬停不再生硬跳变 ===== -->
    <Style Selector="Border.weekRow">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.weekGroup">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.taskPill">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.toolbar /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
        </Transitions>
      </Setter>
    </Style>
  </Window.Styles>

  <!-- 桌面挂件外壳：去掉系统标题栏（SystemDecorations=None）之后，
       窗口本身完全透明，底色 / 圆角 / 细边框都画在这一层上 —— 与 WPF 宿主
       （WindowStyle=None + AllowsTransparency）保持同一套外观。 -->
  <Grid>
    <Border x:Name="Shell"
            CornerRadius="22"
            BorderThickness="1"
            BorderBrush="{DynamicResource WindowEdgeBrush}"
            Background="#D8FFFFFF"
            Padding="8"
            ClipToBounds="True"
            PointerPressed="Shell_PointerPressed"
            PointerMoved="Shell_PointerMoved">
      <Grid RowDefinitions="Auto,*">
        <!-- ===== 顶栏（自适应，最宽两行）：日期信息 + 背景/透明度 + 今天 / 视图 / 设置 / 锁定 =====
             窗口变窄时的降级顺序（由 UpdateResponsiveLayout 驱动，见宿主代码）：
               ① 宽度够  → 全部单行展示；
               ② 放不下了 → 先收起「背景 + 透明度」这两个装饰设置（DateInfoPanel 只剩日期 + 计数）；
               ③ 还是放不下 → 换行：第一行只留日期信息，「今天 / 视图 / 设置 / 锁定」整体挪到第二行。
             这样顶栏永远不会让按钮压在设置项上 —— 横向 StackPanel 超宽时默认是溢出绘制（互相覆盖），
             这里靠「先藏后换行」把重叠消灭掉，而不是靠 ClipToBounds 把内容裁掉。
             行高不锁死：Fluent 滑块拇指是 18px 圆形且模板带触摸边距，固定 26 行会把
             拇指垂直裁成「穹顶」；只给 MinHeight 保底，让滑块按自然高度把行撑开，
             其余 24px 高的控件垂直居中，中线自然对齐。 -->
        <Border x:Name="TopBarBorder" Grid.Row="0" Padding="8,2" BorderBrush="{DynamicResource CellBorderBrush}" BorderThickness="0,0,0,1">
          <Grid x:Name="TopBarGrid" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,*" MinHeight="24" VerticalAlignment="Center">
            <!-- 左侧：日期 + 任务计数 + 背景/透明度（后两者按可用宽度逐级隐藏）。
                 ClipToBounds 是防遮挡的兜底：水平 StackPanel 超宽时默认会溢出绘制到
                 右侧按钮上（任务视图窗口很窄时日期文字就会盖住按钮），裁掉保证不越界。 -->
            <StackPanel x:Name="DateInfoPanel" Grid.Row="0" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center" ClipToBounds="True">
              <TextBlock Text="{Binding TodayDisplay}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
              <!-- 今日 / 本周计数：窄到一定程度后隐藏，给右侧常驻按钮让位 -->
              <StackPanel x:Name="TaskCountsPanel" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="{Binding TodayTaskCount}" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ThisWeekTaskCount}" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
              </StackPanel>
              <!-- 背景 / 透明度：装饰性设置，空间不足时第一个被收起来 -->
              <StackPanel x:Name="ViewControlsPanel" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <TextBlock x:Name="BackgroundLabel" Text="背景" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                <!-- Height + MinHeight 同时锁死 24：Fluent 主题下 ComboBox 自然高度约 32，
                     只给 MinHeight 限不住，会比右侧按钮高出一截。Padding 收紧避免文字/箭头被裁。 -->
                <ComboBox x:Name="BackgroundModeBox" Width="98" Height="24" MinHeight="0" Padding="8,2"
                          FontSize="10.5" VerticalContentAlignment="Center" VerticalAlignment="Center"
                          SelectionChanged="BackgroundMode_Changed">
                  <ComboBoxItem Content="无背景" Tag="None" />
                  <ComboBoxItem Content="白雾玻璃" Tag="FrostedWhite" />
                  <ComboBoxItem Content="灰雾玻璃" Tag="FrostedGray" />
                  <ComboBoxItem Content="暗色磨砂" Tag="FrostedDark" />
                  <ComboBoxItem Content="蓝色亚克力" Tag="AcrylicBlue" />
                  <ComboBoxItem Content="薄荷玻璃" Tag="AcrylicMint" />
                  <ComboBoxItem Content="纸感浅白" Tag="PaperLight" />
                  <ComboBoxItem Content="石墨深色" Tag="Graphite" />
                </ComboBox>
                <TextBlock x:Name="OpacityLabel" Text="透明度" FontSize="10.5" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                <!-- 不能强压 Height：Fluent 滑块拇指是 18px 圆形且模板带触摸边距，
                     高度锁 24 会把圆形拇指垂直裁成「半圆穹顶」。保持自然高度，
                     由固定行高 + VerticalAlignment=Center 保证轨道与其他控件中线对齐。 -->
                <Slider x:Name="OpacitySlider" Width="76" Minimum="0.02" Maximum="1"
                        VerticalAlignment="Center"
                        ValueChanged="Opacity_Changed"
                        PointerWheelChanged="OpacitySlider_Wheel"
                        ToolTip.Tip="鼠标悬停在此处滚动滚轮可调节透明度（按住 Shift 步进更大）" />
              </StackPanel>
            </StackPanel>
            <!-- 「今天 / 视图下拉 / 设置 / 锁定」这一组常驻按钮。
                 它们只有 Width 变成 NaN 才愿意跟 DateInfoPanel 共处一行（Auto 列会无视可用宽度直接溢出），
                 所以这里两组内容按需在「同一行右侧」和「第二行」之间搬家 —— 见 UpdateResponsiveLayout。
                 Grid.Row/Column 走的是附加属性，代码里用 Grid.SetRow / Grid.SetColumn 即可搬。 -->
            <!-- 「今天 / 视图下拉 / 统计 / 周期 / AI / 设置 / 锁定」这一组常驻按钮。
                 用「Auto 列 + * 弹性列」交替排布（不在中间塞普通间隔）：
                 - 窗口够宽、按钮与日期同处一行时，本面板宽度就是内容宽，弹性列归零 → 按钮紧凑；
                 - 换行到第二行、面板被拉满整行时，弹性列吸收全部余量 → 按钮均匀铺开，
                   首尾边框始终与下方内容区（今日任务面板）对齐。
                 这是布局机制保证的，不需要宿主按像素反算间距 —— 那样在缩放过程中会来回跳。
                 Grid.Row/Column 走附加属性，代码里用 Grid.SetRow / Grid.SetColumn 搬行。 -->
            <Grid x:Name="TopActionPanel" Grid.Row="0" Grid.Column="1"
                  ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*,Auto,*,Auto,*,Auto"
                  HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button Grid.Column="0" Classes="toolbar" Content="今天" VerticalAlignment="Center" Click="Today_Click" />
              <!-- 视图切换下拉：月 / 周 / 年 / 任务视图都收在这里，顶栏不再一字排开 -->
              <Button x:Name="ViewMenuButton" Grid.Column="2" Classes="toolbar" VerticalAlignment="Center">
                <Button.Flyout>
                  <MenuFlyout Opening="ViewMenu_Opening">
                    <MenuItem x:Name="ViewMonthItem" Header="月视图" Click="MonthView_Click" />
                    <MenuItem x:Name="ViewWeekItem" Header="周视图" Click="WeekView_Click" />
                    <MenuItem x:Name="ViewYearItem" Header="年视图" Click="YearView_Click" />
                    <MenuItem x:Name="ViewTaskItem" Header="任务视图" Click="TaskView_Click" />
                  </MenuFlyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal" Spacing="4"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                  <TextBlock Text="{Binding CurrentViewLabel}" VerticalAlignment="Center" />
                  <TextBlock Text="▾" FontSize="9" Opacity="0.55" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Grid.Column="4" Classes="toolbar" Content="统计" VerticalAlignment="Center" Click="Statistics_Click"
                      ToolTip.Tip="查看本周 / 本月的任务完成情况统计" />
              <Button Grid.Column="6" Classes="toolbar" Content="周期" VerticalAlignment="Center" Click="RecurringTask_Click"
                      ToolTip.Tip="管理周期任务（每天 / 每周 / 每月 / 每年自动重复）" />
              <Button x:Name="AiButton" Grid.Column="8" Classes="toolbar" Content="AI" VerticalAlignment="Center" Click="AiChat_Click"
                      ToolTip.Tip="AI 对话（自然语言增删改查任务）" />
              <Button Grid.Column="10" Classes="toolbar" Content="设置" VerticalAlignment="Center" Click="Settings_Click" />
              <!-- 锁定：只留锁形图标，不显示文字；锁住后随 .locked 态变红，含义靠 ToolTip 说明。
                   用 Shapes.Path 而非 PathIcon：PathIcon 不支持 Stretch、按几何原始尺寸绘制会溢出。 -->
              <Button x:Name="LockButton" Grid.Column="12" Classes="toolbar" Width="28" Padding="0" VerticalAlignment="Center" Click="LockPosition_Click">
                <Path x:Name="LockIcon" Width="13" Height="13" Stretch="Uniform"
                      Fill="{Binding $parent[Button].Foreground}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Button>
            </Grid>
          </Grid>
        </Border>

        <!-- ===== 主体：按 ViewMode 切换 =====
             月 / 年视图：左侧日历 + 右侧任务面板（两者共用同一份面板实例）；
             周视图：左侧竖排近 7 天日期格子 + 右侧任务面板（左右布局）。 -->
        <Grid x:Name="NormalViewHost" Grid.Row="1">
          <Grid.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
          </Grid.Transitions>

          <!-- 周视图：左侧竖排近 7 天日期格子 + 右侧任务面板（左右布局）。
               左列宽度**固定 132**（WeekScrollColumnWidth），不随窗口缩放变化：
               调窗口大小时只有右侧「今日任务」面板跟着变宽变窄。
               格子高度由宿主按「可用高度 ÷ 7」回填，7 格刚好铺满界面高度。
               整列可上下滚动 —— 默认停在开头（最近 7 天），往下滚能看到后面日期的格子。 -->
          <Grid IsVisible="{Binding IsWeekView}" Margin="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="132" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="WeekScrollViewer" Grid.Column="0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="WeekScroll_ScrollChanged">
              <ItemsControl ItemsSource="{Binding VisibleDays}" ItemTemplate="{StaticResource WeekDayRowTemplate}" />
            </ScrollViewer>
            <!-- 右侧：任务面板占满剩余高度（内容多时内部自己滚动） -->
            <ContentControl Grid.Column="1" Margin="8,0,0,0"
                            Content="{Binding}"
                            ContentTemplate="{StaticResource RightPanelTemplate}" />
          </Grid>

          <!-- 月视图 / 年视图：左侧日历 + 右侧任务面板 -->
          <Grid IsVisible="{Binding IsMonthOrYearView}" ColumnDefinitions="*,216">
          <Grid Grid.Column="0">
          <!-- 月视图：连续月份时间轴 -->
          <ScrollViewer x:Name="MonthScrollViewer"
                        IsVisible="{Binding IsMonthView}"
                        ScrollChanged="MonthScroll_ScrollChanged"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="MonthItemsControl" ItemsSource="{Binding TimelineMonths}" ItemTemplate="{StaticResource MonthBlockTemplate}" Margin="8" />
          </ScrollViewer>

          <!-- 年视图：12 个月三列排布 -->
          <ScrollViewer x:Name="YearScrollViewer"
                        IsVisible="{Binding IsYearView}"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="YearItemsControl" ItemsSource="{Binding YearMonths}" ItemTemplate="{StaticResource YearMonthTemplate}" Margin="8">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </ScrollViewer>
          </Grid>
          <!-- 月 / 年视图的右侧任务面板（两者共用同一份；周视图用的是自己那份，在下面） -->
          <ContentControl Grid.Column="1" Margin="0,8,8,8"
                          Content="{Binding}"
                          ContentTemplate="{StaticResource RightPanelTemplate}" />
          </Grid>

          <!-- 任务视图：没有日历格子，整个主区就是任务面板；宽屏下居中限宽，避免行宽过长难读。
               切换时由 SwitchView 做一次淡入（见容器上的 Opacity 过渡）。 -->
          <Grid x:Name="TaskViewHost" IsVisible="{Binding IsTaskView}">
            <Grid.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" Easing="CubicEaseOut" />
              </Transitions>
            </Grid.Transitions>
            <ContentControl Margin="8"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            MaxWidth="580"
                            Content="{Binding}"
                            ContentTemplate="{StaticResource RightPanelTemplate}" />
          </Grid>
        </Grid>

        <!-- ===== 窄窗视图：窗口窄到放不下日历格子时，整个主体只剩「今日任务」这一块 =====
             与 WPF 宿主 MicaAgenda.App 的 NarrowTaskOnlyView 同一行为：顶栏的视图切换 /
             背景 / 透明度一起收起（否则按了按钮画面没反应，反而更迷惑）。 -->
        <ContentControl x:Name="NarrowTaskOnlyView" Grid.Row="1" IsVisible="False"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Margin="8,8,8,8"
                        Content="{Binding}"
                        ContentTemplate="{StaticResource RightPanelTemplate}">
          <ContentControl.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
          </ContentControl.Transitions>
        </ContentControl>

        <!-- ===== AI 迷你对话覆盖层 =====
             不用 Popup（独立窗口拿不到键盘焦点，输入框打不进字），而是窗口内覆盖层：
             - AiBackdrop：透明背板盖住整窗，点击即关闭（AiBackdrop_PointerPressed）；
             - AiPanel：浮在右上角（顶栏下方），普通控件、键盘焦点正常。
             点击 AI 按钮切开关（AiChat_Click → SetAiPanelOpen）。 -->
        <Border x:Name="AiBackdrop" Grid.RowSpan="2" Background="#01000000"
                IsVisible="False" ZIndex="90"
                PointerPressed="AiBackdrop_PointerPressed" />
        <ctl:AiChatPanel x:Name="AiPanel" Grid.Row="1"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,8,8,0" ZIndex="100" IsVisible="False" />
      </Grid>
    </Border>

    <!-- ===== 边缘 / 角落缩放热区 =====
         窗口是 SystemDecorations=None 的无边框窗体，系统不再提供"拖边缘缩放"。
         外壳 Border 的圆角（22px）会把四个角落排除在命中范围之外 —— 角落处指针落不到 Shell 上，
         PointerPressed/PointerMoved 都不会触发，于是右下角既没有斜向光标、也拖不动。
         这里用四条不可见（alpha=1，肉眼无差）的矩形条补出整圈热区，盖在圆角外壳之上：
         四个角落虽然视觉上是圆的，但仍然能拿到指针事件，斜着拖也能缩放。 -->
    <Border x:Name="ResizeEdgeTop" VerticalAlignment="Top" Height="8" Background="#01000000"
            PointerPressed="Shell_PointerPressed" PointerMoved="Shell_PointerMoved" />
    <Border x:Name="ResizeEdgeBottom" VerticalAlignment="Bottom" Height="8" Background="#01000000"
            PointerPressed="Shell_PointerPressed" PointerMoved="Shell_PointerMoved" />
    <Border x:Name="ResizeEdgeLeft" HorizontalAlignment="Left" Width="8" Background="#01000000"
            PointerPressed="Shell_PointerPressed" PointerMoved="Shell_PointerMoved" />
    <Border x:Name="ResizeEdgeRight" HorizontalAlignment="Right" Width="8" Background="#01000000"
            PointerPressed="Shell_PointerPressed" PointerMoved="Shell_PointerMoved" />

    <!-- ===== 拖拽任务时的幽灵预览：跟随鼠标，显示正在拖拽的任务标题 ===== -->
    <Canvas x:Name="DragGhostLayer" IsHitTestVisible="False" ZIndex="1000">
      <Border x:Name="DragGhost" IsVisible="False" Background="#2563EB" CornerRadius="8"
              Padding="10,6" BoxShadow="0 4 14 0 #40000000">
        <TextBlock x:Name="DragGhostText" Foreground="#FFFFFF" FontSize="12" />
      </Border>
    </Canvas>
  </Grid>
</Window>