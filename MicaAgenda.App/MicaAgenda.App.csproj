<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- PerMonitorV2 让 WPF 在多 DPI 屏之间正确缩放，不会过度放大导致窗口超出屏幕 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- 移除 WinForms 隐式 using，避免与 WPF 命名空间冲突 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Models / ViewModels / 可移植 Services 已抽到 MicaAgenda.Core，与 Avalonia 版
         共用同一份实现，避免迁移期间两边代码漂移 -->
    <ProjectReference Include="..\MicaAgenda.Core\MicaAgenda.Core.csproj" />
  </ItemGroup>

</Project>
