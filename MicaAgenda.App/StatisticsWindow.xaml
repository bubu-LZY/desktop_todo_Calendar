<Window x:Class="MicaAgenda.App.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据统计"
        Width="420" Height="540"
        MinWidth="360" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="#F4F5F7"
        Foreground="#1F2937"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E7E9EF" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8B94A6" />
        <SolidColorBrush x:Key="BodyTextBrush" Color="#374151" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827" />
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <ToggleButton x:Name="WeekBtn" Content="本周" Padding="12,5" Margin="0,0,6,0" Click="Week_Click" />
                <ToggleButton x:Name="MonthBtn" Content="本月" Padding="12,5" Click="Month_Click" />
            </StackPanel>

            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="14,12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="CompletionText" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="OverviewText" FontSize="12" Foreground="{StaticResource BodyTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock x:Name="AvgText" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock x:Name="LongestText" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,10,0,4" />
            <TextBlock x:Name="LongestList" FontSize="12" Foreground="{StaticResource BodyTextBrush}" TextWrapping="Wrap" />

            <TextBlock x:Name="OpenTitle" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,10,0,4" />
            <TextBlock x:Name="OpenList" FontSize="12" Foreground="{StaticResource BodyTextBrush}" TextWrapping="Wrap" />

            <TextBlock x:Name="OverdueTitle" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,10,0,4" />
            <TextBlock x:Name="OverdueList" FontSize="12" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Window>
