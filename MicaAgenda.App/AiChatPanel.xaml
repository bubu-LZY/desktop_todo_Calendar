<UserControl x:Class="MicaAgenda.App.AiChatPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!-- 迷你 AI 对话卡片：输入框在底部（回车发送），反馈内容在上方滚动区。
         配色与设置页卡片一致（白底 + 浅边框 + 蓝色强调），贴合应用浅色主题。 -->
    <Border Background="#FFFFFF" BorderBrush="#EDF0F3" BorderThickness="1" CornerRadius="12" Padding="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.12" />
        </Border.Effect>
    <DockPanel>
        <!-- 顶行：标题 + 日志入口（点击弹出日志查看窗） -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="AI 助手" FontSize="12" FontWeight="SemiBold"
                       Foreground="#111827" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="日志" Click="OpenLog_Click" FontSize="10.5" Padding="8,2"
                    Background="#F5F7FA" BorderBrush="#E2E6EB" BorderThickness="1"
                    Foreground="#374151" Cursor="Hand"
                    ToolTip="查看最近 7 天的 AI 对话日志（自动清理更早的）" />
        </Grid>

        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Grid.Column="0"
                         Padding="8,6" FontSize="12"
                         Background="#F5F7FA" BorderBrush="#E2E6EB" BorderThickness="1"
                         VerticalContentAlignment="Center"
                         KeyDown="InputBox_KeyDown" />
                <Button x:Name="SendButton" Grid.Column="1" Content="发送" Margin="8,0,0,0"
                        Padding="12,6" FontSize="12"
                        Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                        Click="Send_Click" />
            </Grid>

            <ScrollViewer x:Name="ChatScroll" MaxHeight="200" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChatHost" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
