<Window x:Class="MicaAgenda.App.RecurringManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="周期任务"
        Width="560"
        Height="520"
        MinWidth="460"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#F7F8FA"
        Foreground="#111827"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="周期任务会按规则自动生成未来实例，这里统一查看、编辑、删除。"
                   Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="添加周期任务" Click="Add_Click" Padding="14,6" Margin="0,0,8,0"
                    Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" />
            <Button Content="删除全部" Click="DeleteAll_Click" Padding="14,6"
                    Background="White" BorderBrush="#FCA5A5" BorderThickness="1" Foreground="#DC2626" Cursor="Hand" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ListHost" />
        </ScrollViewer>
    </DockPanel>
</Window>
