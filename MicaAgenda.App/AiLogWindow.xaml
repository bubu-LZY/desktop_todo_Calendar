<Window x:Class="MicaAgenda.App.AiLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 对话日志"
        Width="520"
        Height="560"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="#F7F8FA"
        Foreground="#111827"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <!-- AI 对话日志查看窗：只读展示最近 7 天的对话记录（更早的已按周自动清理）。 -->
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="关闭" Click="Close_Click" Padding="14,6"
                    Background="#FFFFFF" BorderBrush="#E2E6EB" BorderThickness="1" Cursor="Hand" />
        </StackPanel>

        <Border Background="#FFFFFF" BorderBrush="#EDF0F3" BorderThickness="1" CornerRadius="12" Padding="10">
            <TextBox x:Name="LogBox"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                     FontFamily="Consolas,Microsoft YaHei" FontSize="11.5"
                     Background="#FFFFFF" BorderThickness="0"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Text="读取中…" />
        </Border>
    </DockPanel>
</Window>
