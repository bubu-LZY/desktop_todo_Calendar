<Window x:Class="MicaAgenda.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="560"
        Height="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#F7F8FA"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#111827" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#2563EB" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- API -->
                <Border Background="#FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="HTTP API" Style="{StaticResource GroupTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="ApiEnabledBox" Content="启用 API" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Text="端口" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ApiPortBox" Width="80" Style="{StaticResource InputBox}" IsReadOnly="True" />
                        </StackPanel>
                        <TextBlock Text="Token（供其他 Agent 调用时鉴权）" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ApiTokenBox" Grid.Column="0" Style="{StaticResource InputBox}" IsReadOnly="True" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="复制" Style="{StaticResource ActionButton}" Click="CopyToken_Click" />
                                <Button Content="重新生成" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="RegenerateToken_Click" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ApiHint" Foreground="#9CA3AF" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 提醒 -->
                <Border Background="#FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="定时提醒" Style="{StaticResource GroupTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="ReminderEnabledBox" Content="启用提醒" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Text="提醒时间" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ReminderTimeBox" Width="70" Style="{StaticResource InputBox}" />
                            <TextBlock Text="（HH:mm）" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="飞书 webhook 地址" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <TextBox x:Name="FeishuWebhookBox" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                        <TextBlock Text="企业微信 webhook 地址" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <TextBox x:Name="WeComWebhookBox" Style="{StaticResource InputBox}" />
                        <TextBlock Text="上面两个地址对「定时提醒」和「定时报告」通用。" Foreground="#9CA3AF" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 定时报告（任务完成情况） -->
                <Border Background="#FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="定时报告（任务完成情况）" Style="{StaticResource GroupTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="ReportEnabledBox" Content="启用报告" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Text="发送时间" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ReportTimeBox" Width="70" Style="{StaticResource InputBox}" />
                            <TextBlock Text="（HH:mm）" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="ReportWeeklyRadio" Content="每周" GroupName="ReportSchedule"
                                         VerticalAlignment="Center" Margin="0,0,6,0"
                                         Checked="ReportSchedule_Changed" />
                            <ComboBox x:Name="ReportDayOfWeekBox" Width="76" Margin="0,0,16,0"
                                      VerticalAlignment="Center" />
                            <RadioButton x:Name="ReportMonthlyRadio" Content="每月" GroupName="ReportSchedule"
                                         VerticalAlignment="Center" Margin="0,0,6,0"
                                         Checked="ReportSchedule_Changed" />
                            <ComboBox x:Name="ReportDayOfMonthBox" Width="66" Margin="0,0,6,0"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="号（超出当月天数自动取月末）" Foreground="#9CA3AF" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="报告内容：完成率、耗时最长 / 完成最快 / 超时完成 / 至今未完成 / 逾期未完成。" Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="推送渠道" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="ReportSendFeishuBox" Content="飞书" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <CheckBox x:Name="ReportSendWeComBox" Content="企业微信" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="自定义 webhook（可选；自动识别飞书并用卡片推送，其他地址按企微 text 格式推送）"
                                   Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <TextBox x:Name="ReportCustomWebhookBox" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ReportPreviewButton" Content="预览报告" Style="{StaticResource ActionButton}" Click="ReportPreview_Click" />
                            <Button x:Name="ReportSendNowButton" Content="立即发送" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="ReportSendNow_Click" />
                        </StackPanel>
                        <TextBox x:Name="ReportPreviewBox"
                                 Height="180"
                                 Margin="0,10,0,0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="11.5"
                                 FontFamily="Consolas, Microsoft YaHei"
                                 Visibility="Collapsed" />
                        <TextBlock x:Name="ReportActionStatus" Foreground="#157347" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 备份 -->
                <Border Background="#FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="自动备份" Style="{StaticResource GroupTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="BackupEnabledBox" Content="启用自动备份" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Text="备份时间" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="BackupTimeBox" Width="70" Style="{StaticResource InputBox}" />
                            <TextBlock Text="（HH:mm）" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="每天到点自动导出全年任务 JSON，保存到本地。" Foreground="#9CA3AF" FontSize="12" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="BackupSendFeishuBox" Content="备份后发送到飞书" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <CheckBox x:Name="BackupSendWeComBox" Content="备份后发送到企业微信" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BackupNowButton" Content="立即备份" Style="{StaticResource ActionButton}" Click="BackupNow_Click" />
                            <Button Content="打开备份文件夹" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="OpenBackupFolder_Click" />
                            <Button Content="导出 JSON" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="ExportJson_Click" />
                            <Button Content="导入 JSON" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="ImportJson_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- MCP -->
                <Border Background="#FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="MCP 接口（供外部 AI 客户端连接）" Style="{StaticResource GroupTitle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="McpEnabledBox" Content="启用 MCP" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Text="端口" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="McpPortBox" Width="80" Style="{StaticResource InputBox}" IsReadOnly="True" />
                        </StackPanel>
                        <TextBlock Text="MCP 端点地址" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <TextBox x:Name="McpEndpointBox" Style="{StaticResource InputBox}" IsReadOnly="True" Margin="0,0,0,10" />
                        <CheckBox x:Name="SyncMyMindMapBox" Content="同步 my mind map agent（把 [MM复习] 任务的勾选状态实时同步回复习计划；删除任务不删除复习计划）" Margin="0,0,0,8" />
                        <TextBlock Text="my mind map agent 本地 HTTP 地址" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <TextBox x:Name="MindMapBaseUrlBox" Style="{StaticResource InputBox}" Margin="0,0,0,8" />
                        <TextBlock Text="my mind map agent 本地 HTTP Token（端口 17800，不是 MCP Token）" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                        <TextBox x:Name="MyMindMapTokenBox" Style="{StaticResource InputBox}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="TestMyMindMapButton" Content="测试连接" Style="{StaticResource ActionButton}" Click="TestMyMindMap_Click" />
                            <Button x:Name="SyncMindMapNowButton" Content="立即同步" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="SyncMindMapNow_Click" />
                            <TextBlock x:Name="MyMindMapTestStatus" Foreground="#157347" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="SyncMindMapStatus" Foreground="#157347" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <TextBlock Margin="0,0,0,8">
                            <Hyperlink Click="OpenMindMapAgentProject_Click">什么是 my mind map agent？</Hyperlink>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CopySkillDocButton" Content="复制 Skill 文档" Style="{StaticResource ActionButton}" Click="CopySkillDoc_Click" />
                            <Button x:Name="CopyMcpConfigButton" Content="复制 MCP 配置 JSON" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="CopyMcpConfig_Click" />
                        </StackPanel>
                        <TextBlock Text="Claude Desktop / Cursor 等客户端添加 MCP Server 后，即可直接调用本程序的查询/增删改查任务等工具。" Foreground="#9CA3AF" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 桌面行为 -->
                <Border Background="#FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="桌面行为" Style="{StaticResource GroupTitle}" />
                        <CheckBox x:Name="EmbedDesktopBox" Content="嵌入桌面（置底模式：沉在其他窗口之下）" Margin="0,0,0,8" />
                        <CheckBox x:Name="LockWindowBox" Content="锁定位置（禁止拖动 / 缩放）" />
                        <CheckBox x:Name="AutoStartBox" Content="开机自启动" Margin="0,8,0,0" />
                        <CheckBox x:Name="HighPriorityBox" Content="高优先级开机启动（需要管理员权限）" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 重置 -->
                <Border Background="#FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12" BorderBrush="#FCA5A5" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="重置" Style="{StaticResource GroupTitle}" Foreground="#991B1B" />
                        <TextBlock Text="一键清空所有任务：删除数据库里的全部任务，并把右侧面板 / 日历格 / 本周统计 / 备份里的任务都清掉。重置后程序相当于新装状态，下次保存会自动落盘。"
                                   Foreground="#7F1D1D" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DeleteAllTasksButton" Content="一键删除所有任务" Padding="14,7" BorderThickness="1" BorderBrush="#DC2626" Background="#DC2626" Foreground="#FFFFFF" FontWeight="SemiBold" Cursor="Hand" Click="DeleteAllTasks_Click" />
                            <TextBlock x:Name="DeleteAllTasksStatus" Foreground="#157347" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="#FFFFFF" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="节假日数据" Style="{StaticResource GroupTitle}" />
                        <TextBlock Text="数据来自 timor.tech/api/holiday（每年首次进入时联网拉取，缓存 TTL 7 天）。国务院临时调休会在下次联网时自动同步。"
                                   Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock x:Name="HolidayStatusText"
                                   Foreground="#374151" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="读取中…" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button x:Name="HolidayRefreshNowButton" Content="立即刷新" Style="{StaticResource ActionButton}" Click="HolidayRefreshNow_Click" />
                            <Button x:Name="HolidayClearCacheButton" Content="清空本地缓存" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="HolidayClearCache_Click" />
                        </StackPanel>
                        <TextBlock x:Name="HolidayRefreshStatus" Foreground="#157347" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Style="{StaticResource ActionButton}" Click="Cancel_Click" Margin="0,0,10,0" />
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
