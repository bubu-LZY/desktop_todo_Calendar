<Window x:Class="MicaAgenda.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="620"
        Height="620"
        MinWidth="540"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="SingleBorderWindow"
        Background="#F4F5F7"
        Foreground="#1F2937"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- 配色：整页浅灰底 + 纯白圆角卡片，弱边框代替描边，避免生硬 -->
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E7E9EF" />
        <SolidColorBrush x:Key="FieldBorderBrush" Color="#DDE1E8" />
        <SolidColorBrush x:Key="FieldHoverBorderBrush" Color="#C4CBD8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="BodyTextBrush" Color="#374151" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8B94A6" />
        <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C" />
        <SolidColorBrush x:Key="DangerPressedBrush" Color="#991B1B" />
        <SolidColorBrush x:Key="SuccessTextBrush" Color="#15803D" />
        <SolidColorBrush x:Key="SoftFillBrush" Color="#F5F7FA" />
        <SolidColorBrush x:Key="SoftFillHoverBrush" Color="#EFF2F7" />

        <!-- 卡片：圆角 10 + 1px 浅边框，比纯白方块柔和 -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,13" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- 分组标题：左侧一根细色条 + 半粗标题 -->
        <Style x:Key="SectionBar" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="13" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SoftLink" TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="TextDecorations" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 复选框：圆角方框 + 选中填充强调色，整行悬停有浅色底 -->
        <Style x:Key="SoftCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Pill" CornerRadius="6" Background="Transparent" Padding="5,2" Margin="-5,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                        Background="#FFFFFF" BorderBrush="#C4CBD8" BorderThickness="1.2"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Path x:Name="Mark" Data="M 3.5 8.2 L 6.6 11.2 L 12.2 4.6"
                                          Stroke="#FFFFFF" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource SoftFillHoverBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Background" Value="#EDEFF3" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#DDE1E8" />
                                <Setter Property="Foreground" Value="#9CA3AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 单选框：圆形 + 选中填充强调色 -->
        <Style x:Key="SoftRadioButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" CornerRadius="6" Background="Transparent" Padding="5,2" Margin="-5,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                        Background="#FFFFFF" BorderBrush="#C4CBD8" BorderThickness="1.2"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#FFFFFF" Visibility="Collapsed" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource SoftFillHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框选项：圆角高亮 -->
        <Style x:Key="SoftComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Margin="4,1" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SoftFillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5EDFF" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框：圆角、悬停变边框、下拉面板带阴影 -->
        <Style x:Key="SoftComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,0,26,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource SoftComboBoxItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="7"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Path x:Name="Arrow" Data="M 0 0 L 4 4.5 L 8 0"
                                                  Stroke="#8B94A6" StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldHoverBorderBrush}" />
                                                <Setter TargetName="Bd" Property="Background" Value="#FAFBFD" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   Placement="Bottom" PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260" Margin="0,3,0,0"
                                        CornerRadius="8" Background="#FFFFFF"
                                        BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.16" Color="#111827" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,3">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 单行输入框：圆角 + 聚焦强调色边框 + 只读灰底 -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F7F8FA" />
                                <Setter Property="Foreground" Value="#4B5563" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                                <Setter Property="Foreground" Value="#9CA3AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 多行只读文本域：内容顶对齐，可滚动 -->
        <Style x:Key="CodeBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="Background" Value="#FAFBFC" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                          VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮：白底圆角，悬停浅灰 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource BodyTextBrush}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SoftFillBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FieldHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SoftFillHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E5E7EB" />
                                <Setter Property="Foreground" Value="#9CA3AF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮：强调蓝填充 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#A9C2F2" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A9C2F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险按钮：红色填充 -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Padding" Value="18,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerHoverBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerPressedBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F0A9A9" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#F0A9A9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 滚动条：细圆角滑块，悬停加深；无箭头 -->
        <Style x:Key="SoftScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Width="6" CornerRadius="3" HorizontalAlignment="Center"
                                Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoftScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource SoftScrollPageButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ScrollThumb" Style="{StaticResource SoftScrollThumb}" Background="#C7CEDA" Margin="0,2" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource SoftScrollPageButton}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ScrollThumb" Property="Background" Value="#9AA3B2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Padding="20,20,10,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- API -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <Border Style="{StaticResource SectionBar}" />
                            <TextBlock Text="HTTP API" Style="{StaticResource GroupTitle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="ApiEnabledBox" Content="启用 API" Style="{StaticResource SoftCheckBox}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Text="端口" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                            <TextBox x:Name="ApiPortBox" Width="80" Style="{StaticResource InputBox}" IsReadOnly="True" />
                        </StackPanel>
                        <TextBlock Text="Token（供其他 Agent 调用时鉴权）" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ApiTokenBox" Grid.Column="0" Style="{StaticResource InputBox}" IsReadOnly="True" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="复制" Style="{StaticResource ActionButton}" Click="CopyToken_Click" />
                                <Button Content="重新生成" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="RegenerateToken_Click" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="ApiHint" Style="{StaticResource HintText}" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <!-- 提醒 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <Border Style="{StaticResource SectionBar}" />
                            <TextBlock Text="定时提醒" Style="{StaticResource GroupTitle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="ReminderEnabledBox" Content="启用提醒" Style="{StaticResource SoftCheckBox}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Text="提醒时间" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                            <TextBox x:Name="ReminderTimeBox" Width="70" Style="{StaticResource InputBox}" />
                            <TextBlock Text="（HH:mm）" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="5,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="飞书 webhook 地址" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                        <TextBox x:Name="FeishuWebhookBox" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                        <TextBlock Text="企业微信 webhook 地址" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                        <TextBox x:Name="WeComWebhookBox" Style="{StaticResource InputBox}" />
                        <TextBlock Text="上面两个地址对「定时提醒」和「定时报告」通用。" Style="{StaticResource HintText}" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <!-- 定时报告（任务完成情况） -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <Border Style="{StaticResource SectionBar}" />
                            <TextBlock Text="定时报告（任务完成情况）" Style="{StaticResource GroupTitle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="ReportEnabledBox" Content="启用报告" Style="{StaticResource SoftCheckBox}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Text="发送时间" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                            <TextBox x:Name="ReportTimeBox" Width="70" Style="{StaticResource InputBox}" />
                            <TextBlock Text="（HH:mm）" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="5,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <RadioButton x:Name="ReportWeeklyRadio" Content="每周" GroupName="ReportSchedule" Style="{StaticResource SoftRadioButton}" VerticalAlignment="Center" Margin="0,0,6,0" Checked="ReportSchedule_Changed" />
                            <ComboBox x:Name="ReportDayOfWeekBox" Width="76" Margin="0,0,16,0" VerticalAlignment="Center" Style="{StaticResource SoftComboBox}" />
                            <RadioButton x:Name="ReportMonthlyRadio" Content="每月" GroupName="ReportSchedule" Style="{StaticResource SoftRadioButton}" VerticalAlignment="Center" Margin="0,0,6,0" Checked="ReportSchedule_Changed" />
                            <ComboBox x:Name="ReportDayOfMonthBox" Width="66" Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource SoftComboBox}" />
                            <TextBlock Text="号（超出当月天数自动取月末）" Style="{StaticResource HintText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="报告内容：完成率、耗时最长 / 完成最快 / 超时完成 / 至今未完成 / 逾期未完成。" Style="{StaticResource HintText}" Margin="0,0,0,10" />
                        <TextBlock Text="推送渠道" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="ReportSendFeishuBox" Content="飞书" Style="{StaticResource SoftCheckBox}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <CheckBox x:Name="ReportSendWeComBox" Content="企业微信" Style="{StaticResource SoftCheckBox}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="自定义 webhook（可选；自动识别飞书并用卡片推送，其他地址按企微 text 格式推送）" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                        <TextBox x:Name="ReportCustomWebhookBox" Style="{StaticResource InputBox}" Margin="0,0,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ReportPreviewButton" Content="预览报告" Style="{StaticResource ActionButton}" Click="ReportPreview_Click" />
                            <Button x:Name="ReportSendNowButton" Content="立即发送" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="ReportSendNow_Click" />
                        </StackPanel>
                        <TextBox x:Name="ReportPreviewBox" Style="{StaticResource CodeBox}"
                                 Height="140" Margin="0,10,0,0" IsReadOnly="True"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="11.5" FontFamily="Consolas, Microsoft YaHei"
                                 Visibility="Collapsed" />
                        <TextBlock x:Name="ReportActionStatus" Style="{StaticResource StatusText}" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <!-- 备份 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <Border Style="{StaticResource SectionBar}" />
                            <TextBlock Text="自动备份" Style="{StaticResource GroupTitle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="BackupEnabledBox" Content="启用自动备份" Style="{StaticResource SoftCheckBox}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Text="备份时间" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                            <TextBox x:Name="BackupTimeBox" Width="70" Style="{StaticResource InputBox}" />
                            <TextBlock Text="（HH:mm）" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="5,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="每天到点自动导出全年任务 JSON，保存到本地。" Style="{StaticResource HintText}" Margin="0,0,0,7" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="BackupSendFeishuBox" Content="备份后发送到飞书" Style="{StaticResource SoftCheckBox}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <CheckBox x:Name="BackupSendWeComBox" Content="备份后发送到企业微信" Style="{StaticResource SoftCheckBox}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BackupNowButton" Content="立即备份" Style="{StaticResource ActionButton}" Click="BackupNow_Click" />
                            <Button Content="打开备份文件夹" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="OpenBackupFolder_Click" />
                            <Button Content="导出 JSON" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="ExportJson_Click" />
                            <Button Content="导入 JSON" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="ImportJson_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- MCP -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <Border Style="{StaticResource SectionBar}" />
                            <TextBlock Text="MCP 接口（供外部 AI 客户端连接）" Style="{StaticResource GroupTitle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="McpEnabledBox" Content="启用 MCP" Style="{StaticResource SoftCheckBox}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Text="端口" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                            <TextBox x:Name="McpPortBox" Width="80" Style="{StaticResource InputBox}" IsReadOnly="True" />
                        </StackPanel>
                        <TextBlock Text="MCP 端点地址" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                        <TextBox x:Name="McpEndpointBox" Style="{StaticResource InputBox}" IsReadOnly="True" Margin="0,0,0,10" />
                        <CheckBox x:Name="SyncMyMindMapBox" Content="同步 my mind map agent（把 [MM复习] 任务的勾选状态实时同步回复习计划；删除任务不删除复习计划）" Style="{StaticResource SoftCheckBox}" Margin="0,0,0,6" />
                        <TextBlock Text="my mind map agent 本地 HTTP 地址" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                        <TextBox x:Name="MindMapBaseUrlBox" Style="{StaticResource InputBox}" Margin="0,0,0,9" />
                        <TextBlock Text="my mind map agent 本地 HTTP Token（端口 17800，不是 MCP Token）" Style="{StaticResource FieldLabel}" Margin="0,0,0,5" />
                        <TextBox x:Name="MyMindMapTokenBox" Style="{StaticResource InputBox}" Margin="0,0,0,9" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <Button x:Name="TestMyMindMapButton" Content="测试连接" Style="{StaticResource ActionButton}" Click="TestMyMindMap_Click" />
                            <Button x:Name="SyncMindMapNowButton" Content="立即同步" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="SyncMindMapNow_Click" />
                            <TextBlock x:Name="MyMindMapTestStatus" Style="{StaticResource StatusText}" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="SyncMindMapStatus" Style="{StaticResource StatusText}" Margin="0,0,0,9" />
                        <TextBlock Margin="0,0,0,9">
                            <Hyperlink Style="{StaticResource SoftLink}" Click="OpenMindMapAgentProject_Click">什么是 my mind map agent？</Hyperlink>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CopySkillDocButton" Content="复制 Skill 文档" Style="{StaticResource ActionButton}" Click="CopySkillDoc_Click" />
                            <Button x:Name="CopyMcpConfigButton" Content="复制 MCP 配置 JSON" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="CopyMcpConfig_Click" />
                        </StackPanel>
                        <TextBlock Text="Claude Desktop / Cursor 等客户端添加 MCP Server 后，即可直接调用本程序的查询/增删改查任务等工具。" Style="{StaticResource HintText}" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>

                <!-- 桌面行为 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <Border Style="{StaticResource SectionBar}" />
                            <TextBlock Text="桌面行为" Style="{StaticResource GroupTitle}" />
                        </StackPanel>
                        <CheckBox x:Name="EmbedDesktopBox" Content="嵌入桌面（置底模式：沉在其他窗口之下）" Style="{StaticResource SoftCheckBox}" Margin="0,0,0,4" />
                        <CheckBox x:Name="LockWindowBox" Content="锁定位置（禁止拖动 / 缩放）" Style="{StaticResource SoftCheckBox}" />
                        <CheckBox x:Name="AutoStartBox" Content="开机自启动" Style="{StaticResource SoftCheckBox}" Margin="0,4,0,0" />
                        <CheckBox x:Name="HighPriorityBox" Content="高优先级开机启动（需要管理员权限）" Style="{StaticResource SoftCheckBox}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- 重置 -->
                <Border Style="{StaticResource Card}" Background="#FFFCFC" BorderBrush="#F3D6D6">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <Border Style="{StaticResource SectionBar}" Background="{StaticResource DangerBrush}" />
                            <TextBlock Text="重置" Style="{StaticResource GroupTitle}" Foreground="#B91C1C" />
                        </StackPanel>
                        <TextBlock Text="一键清空所有任务：删除数据库里的全部任务，并把右侧面板 / 日历格 / 本周统计 / 备份里的任务都清掉。重置后程序相当于新装状态，下次保存会自动落盘。"
                                   Foreground="#9B4B4B" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,9" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DeleteAllTasksButton" Content="一键删除所有任务" Style="{StaticResource DangerButton}" Click="DeleteAllTasks_Click" />
                            <TextBlock x:Name="DeleteAllTasksStatus" Style="{StaticResource StatusText}" Margin="10,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 节假日 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource SectionHeader}">
                            <Border Style="{StaticResource SectionBar}" />
                            <TextBlock Text="节假日数据" Style="{StaticResource GroupTitle}" />
                        </StackPanel>
                        <TextBlock Text="数据来自 timor.tech/api/holiday（每年首次进入时联网拉取，缓存 TTL 7 天）。国务院临时调休会在下次联网时自动同步。" Style="{StaticResource HintText}" Margin="0,0,0,7" />
                        <TextBlock x:Name="HolidayStatusText" Foreground="#374151" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,9" Text="读取中…" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="HolidayRefreshNowButton" Content="立即刷新" Style="{StaticResource ActionButton}" Click="HolidayRefreshNow_Click" />
                            <Button x:Name="HolidayClearCacheButton" Content="清空本地缓存" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="HolidayClearCache_Click" />
                        </StackPanel>
                        <TextBlock x:Name="HolidayRefreshStatus" Style="{StaticResource StatusText}" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#FAFBFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="20,13">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource ActionButton}" Click="Cancel_Click" Margin="0,0,10,0" />
                <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
